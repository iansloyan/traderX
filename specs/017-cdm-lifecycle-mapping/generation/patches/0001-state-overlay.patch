+++ b/web-front-end/angular/main/app/cdm/cdm.service.ts
@@ -0,0 +1,335 @@
+import { Injectable } from '@angular/core';
+import { HttpClient, HttpErrorResponse } from '@angular/common/http';
+import { Observable, of, throwError } from 'rxjs';
+import { catchError, map } from 'rxjs/operators';
+import { environment } from 'main/environments/environment';
+
+/** Validation of one stored CDM object (cdm-service CdmValidator). */
+export type CdmValidationStatus = 'VALID' | 'INVALID' | 'NOT_QUALIFIED';
+
+export interface CdmValidation {
+    status: CdmValidationStatus | string;
+    messages: string[];
+}
+
+/**
+ * Derived by cdm-service from the WorkflowStep: an order's own versions are `proposed`, `approved`
+ * (venue approval) or `rejected`, and `cancel`; a fill's steps are `fill-proposed` and `fill-accepted`;
+ * a direct trade's are `proposed` and `accepted`.
+ */
+export type CdmStepType = 'proposed' | 'approved' | 'rejected' | 'cancel' | 'fill-proposed' | 'fill-accepted' | 'accepted' | string;
+
+/**
+ * One stored CDM version. `storeGlobalKey` is the store's SHA-256 of the canonical JSON (what
+ * versions are chained by); `cdmGlobalKey` is the object's Rune `meta.globalKey` (what references
+ * inside CDM objects, such as `previousWorkflowStep`, use).
+ */
+export interface CdmStoredObject {
+    storeGlobalKey: string;
+    cdmGlobalKey: string | null;
+    previousStoreGlobalKey: string | null;
+    cdmType: string;
+    validation: CdmValidation;
+    createdAt?: string;
+    object?: any;
+}
+
+export interface CdmLineageStep extends CdmStoredObject {
+    stepType: CdmStepType;
+    timestamp: string | null;
+}
+
+/** A stored TradeState as the order lineage summarises it under a fill. */
+export interface CdmTradeStateSummary {
+    cdmRef: string;
+    storeGlobalKey: string;
+    cdmGlobalKey: string | null;
+    positionState: string | null;
+    validation: CdmValidation;
+}
+
+/** The venue's answer to an order proposal (CDM `WorkflowStep.approval`). */
+export interface CdmApproval {
+    approved: boolean;
+    /** cdmRef of the approving party (the venue). */
+    party: string | null;
+    timestamp: string | null;
+    rejectedReason: string | null;
+    stepStoreGlobalKey: string | null;
+}
+
+/** The order's own workflow: its proposal versions and the venue's approval. */
+export interface CdmProposal {
+    executionType: string | null;
+    executionTypeMeaning: string | null;
+    versions: CdmLineageStep[];
+    approval: CdmApproval | null;
+}
+
+/**
+ * One fill of an order: its own proposed -> accepted workflow and the trade state the accepted
+ * step's execution produced. `label` and `fillNumber` are computed by cdm-service in booking order.
+ */
+export interface CdmFill {
+    fillNumber: number;
+    label: string;
+    tradeId: string;
+    quantity: number | null;
+    price: number | null;
+    executedAt: string | null;
+    filledSoFar: number | null;
+    executionType: string | null;
+    executionTypeMeaning: string | null;
+    proposed: CdmLineageStep;
+    accepted: CdmLineageStep | null;
+    tradeState: CdmTradeStateSummary | null;
+}
+
+export interface CdmPartyRef {
+    cdmRef: string;
+    role: string;
+    accountId?: number | null;
+    name: string | null;
+}
+
+export interface CdmLifecycleFailure {
+    id: number;
+    cdmRef: string;
+    stage: string;
+    message: string;
+    failedAt: string;
+    payload?: string;
+}
+
+export interface CdmPendingEvent {
+    tradeId?: string;
+    receivedAt: string;
+    reportedAt: string | null;
+    payload: any;
+}
+
+/** GET /cdm/orders/{orderId}/lineage */
+export interface CdmOrderLineage {
+    cdmRef: string;
+    orderId: string;
+    status: string;
+    instructionQuantity: number;
+    executedQuantity: number;
+    canceledQuantity: number;
+    remainingQuantity: number;
+    remainingQuantityFormula?: string;
+    quantityWarning: string | null;
+    proposal: CdmProposal;
+    fills: CdmFill[];
+    cancel: CdmLineageStep | null;
+    /** account = the client (Party2); dealer = the facing TraderX subsidiary (Party1); venue = the execution facility (absent for a direct trade). */
+    parties: { account?: CdmPartyRef; dealer?: CdmPartyRef; venue?: CdmPartyRef };
+    security: { cdmRef: string; ticker: string; companyName: string } | null;
+    failures: CdmLifecycleFailure[];
+    pending: { trades: CdmPendingEvent[]; cancel: CdmPendingEvent | null };
+}
+
+/** What produced a trade state: a fill of an order, or a direct trade's own workflow. */
+export interface CdmProducedBy {
+    cdmRef: string;
+    storeGlobalKey: string | null;
+    kind: 'fill' | 'direct' | string;
+    orderId: string | null;
+    fillNumber: number | null;
+    label: string | null;
+    lineage: string | null;
+    /** Present on the trade lineage only: the producer's two steps. */
+    proposed?: CdmLineageStep | null;
+    accepted?: CdmLineageStep | null;
+}
+
+/** The trade state's own fields as the trade lineage gives them. */
+export interface CdmTradeStateDetail extends CdmTradeStateSummary {
+    tradeId: string;
+    previousStoreGlobalKey: string | null;
+    quantity: number | null;
+    price: number | null;
+    side: string | null;
+    account: { cdmRef: string; name: string | null } | null;
+    dealer?: { cdmRef: string; name: string | null } | null;
+    venue: { cdmRef: string; name: string | null } | null;
+    security: { cdmRef: string; ticker: string; companyName: string | null } | null;
+}
+
+/** GET /cdm/trades/{tradeId}/lineage: the trade state first, then what produced it. */
+export interface CdmTradeLineage {
+    cdmRef: string;
+    tradeId: string;
+    tradeState: CdmTradeStateDetail | null;
+    executionType: string | null;
+    executionTypeMeaning: string | null;
+    producedBy: CdmProducedBy | null;
+}
+
+/** GET /cdm/trades/{tradeId} */
+export interface CdmTrade {
+    cdmRef: string;
+    tradeState: CdmStoredObject | null;
+    producedBy: CdmProducedBy | null;
+    executionType: string | null;
+    executionTypeMeaning: string | null;
+}
+
+/** One trade state contributing to a position; the signed quantities sum to the position's quantity. */
+export interface CdmPositionTrade {
+    tradeId: string;
+    cdmRef: string;
+    signedQuantity: number;
+    price: number | null;
+    side: string | null;
+    /** An ISO time; cdm-service may send the string "null" when it has none. */
+    executedAt: string | null;
+}
+
+export interface CdmPosition {
+    cdmRef: string;
+    security: string;
+    quantity: number;
+    trades: CdmPositionTrade[];
+}
+
+/** GET /cdm/positions/{accountId} (the account's PortfolioState and its positions per security). */
+export interface CdmPositions {
+    cdmRef: string;
+    cdmType?: string;
+    storeGlobalKey?: string | null;
+    cdmGlobalKey?: string | null;
+    validation?: CdmValidation | null;
+    object?: any;
+    positions: CdmPosition[];
+}
+
+/** GET /cdm/validation-summary */
+export interface CdmValidationSummary {
+    objects: { total: number; byStatus: { [status: string]: number }; byType: { [type: string]: any } };
+    latest: { total: number; byStatus: { [status: string]: number } };
+    notValid: { cdmRef: string; cdmType: string; storeGlobalKey: string; status: string; messages: string[] }[];
+    failures: { total: number; recent: CdmLifecycleFailure[] };
+    pending: { trades: number; cancels: number };
+    backfill?: { directTrades: string; openOrders: string; complete: boolean };
+}
+
+export interface CdmRejection {
+    rejectionId: string;
+    cdmRef: string;
+    accountId: number | null;
+    quantity: number;
+    reason: string | null;
+    rejectedAt: string | null;
+    storeGlobalKey: string;
+    cdmGlobalKey: string | null;
+    validation: CdmValidation;
+    lineage: string;
+}
+
+/** GET /cdm/rejections?accountId= */
+export interface CdmRejections {
+    accountId?: number;
+    count: number;
+    rejections: CdmRejection[];
+}
+
+/**
+ * A CDM read: either the object, or `pending` when cdm-service answers
+ * 404 {"cdmRef": ..., "status": "pending"} (a well-formed ref the lifecycle adapter has not stored yet).
+ */
+export type CdmResult<T> =
+    | { status: 'ok'; data: T }
+    | { status: 'pending'; cdmRef: string | null };
+
+/** Read client for the state 017 cdm-service (`/cdm-service/cdm/...` behind the ingress). */
+@Injectable({
+    providedIn: 'root'
+})
+export class CdmService {
+    private readonly baseUrl = `${environment.cdmServiceUrl}/cdm`;
+
+    constructor(private http: HttpClient) {}
+
+    orderLineage(orderId: string): Observable<CdmResult<CdmOrderLineage>> {
+        return this.read<CdmOrderLineage>(`${this.baseUrl}/orders/${encodeURIComponent(orderId)}/lineage`);
+    }
+
+    tradeLineage(tradeId: string): Observable<CdmResult<CdmTradeLineage>> {
+        return this.read<CdmTradeLineage>(`${this.baseUrl}/trades/${encodeURIComponent(tradeId)}/lineage`);
+    }
+
+    trade(tradeId: string): Observable<CdmResult<CdmTrade>> {
+        return this.read<CdmTrade>(`${this.baseUrl}/trades/${encodeURIComponent(tradeId)}`);
+    }
+
+    resolve(cdmRef: string): Observable<CdmResult<any>> {
+        return this.read<any>(`${this.baseUrl}/resolve/${encodeURIComponent(cdmRef)}`);
+    }
+
+    /** CDM Party of an account id (with its related persons), or a subsidiary or the venue party by its key. */
+    party(key: string | number): Observable<any> {
+        return this.http.get<any>(`${this.baseUrl}/parties/${encodeURIComponent(String(key))}`);
+    }
+
+    /** The TraderX subsidiaries that can face a client (CDM parties). */
+    entities(): Observable<any[]> {
+        return this.http.get<any[]>(`${this.baseUrl}/entities`);
+    }
+
+    /** Makes the subsidiary `entity` face account `accountId` (CDM Account.servicingParty); answers the updated party. */
+    setServicingParty(accountId: number, entity: string): Observable<any> {
+        return this.http.put<any>(`${this.baseUrl}/parties/${encodeURIComponent(String(accountId))}/servicing-party`, { entity });
+    }
+
+    /** CDM Security by ticker (ticker, demo ISIN and demo FIGI identifiers). */
+    security(ticker: string): Observable<any> {
+        return this.http.get<any>(`${this.baseUrl}/securities/${encodeURIComponent(ticker)}`);
+    }
+
+    /**
+     * The account's CDM positions, each with the trade states that sum to it; `pending` when the
+     * account has no CDM trades yet (cdm-service answers 404 {"status":"pending"}).
+     */
+    positions(accountId: number): Observable<CdmResult<CdmPositions>> {
+        return this.read<CdmPositions>(`${this.baseUrl}/positions/${encodeURIComponent(String(accountId))}`);
+    }
+
+    validationSummary(): Observable<CdmValidationSummary> {
+        return this.http.get<CdmValidationSummary>(`${this.baseUrl}/validation-summary`);
+    }
+
+    rejections(accountId?: number): Observable<CdmRejections> {
+        const query = accountId != null ? `?accountId=${accountId}` : '';
+        return this.http.get<CdmRejections>(`${this.baseUrl}/rejections${query}`);
+    }
+
+    private read<T>(url: string): Observable<CdmResult<T>> {
+        return this.http.get<T>(url).pipe(
+            map((data): CdmResult<T> => ({ status: 'ok', data })),
+            catchError((error: HttpErrorResponse) => {
+                const pending = CdmService.pendingBody(error);
+                if (pending) {
+                    return of<CdmResult<T>>({ status: 'pending', cdmRef: pending.cdmRef ?? null });
+                }
+                return throwError(() => error);
+            })
+        );
+    }
+
+    /** The body of a 404 {"status":"pending"} answer, or null for any other error. */
+    static pendingBody(error: HttpErrorResponse): { cdmRef?: string; status: string } | null {
+        if (!error || error.status !== 404) {
+            return null;
+        }
+        let body: any = error.error;
+        if (typeof body === 'string') {
+            try {
+                body = JSON.parse(body);
+            } catch {
+                return null;
+            }
+        }
+        return body && body.status === 'pending' ? body : null;
+    }
+}
