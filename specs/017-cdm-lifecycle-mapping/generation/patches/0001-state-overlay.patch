+package finos.traderx.positionservice.model;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.math.BigDecimal;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/** State 017: positions carry an optional, derived cdmRef next to the 009 fields. */
+class PositionTest {
+
+  @Test
+  void jsonKeepsThe009FieldsAndAddsCdmRef() {
+    Position position = new Position();
+    position.setAccountId(22214);
+    position.setSecurity("IBM");
+    position.setQuantity(1300);
+    position.setAverageCostBasis(new BigDecimal("179.231"));
+
+    JsonNode json = JsonMapper.builder().build().valueToTree(position);
+
+    assertThat(json.get("cdmRef").asString()).isEqualTo("cdm:position:22214:IBM");
+    assertThat(json.get("accountId").asInt()).isEqualTo(22214);
+    assertThat(json.get("security").asString()).isEqualTo("IBM");
+    assertThat(json.get("quantity").asInt()).isEqualTo(1300);
+    assertThat(json.has("averageCostBasis")).isTrue();
+    assertThat(json.has("updated")).isTrue();
+  }
+
+  @Test
+  void noCdmRefWithoutItsKey() {
+    assertThat(new Position().getCdmRef()).isNull();
+  }
+}
