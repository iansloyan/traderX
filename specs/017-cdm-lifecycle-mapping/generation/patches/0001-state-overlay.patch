@@ -0,0 +1,70 @@
+package finos.traderx.ordermatcher.api;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.UUID;
+
+/**
+ * Event published on {@code /orders/rejected} when an order create request fails validation.
+ * Fields echo the request as received and are explicitly null when absent.
+ */
+@JsonInclude(JsonInclude.Include.ALWAYS)
+public class RejectedOrder {
+    private String rejectionId;
+    private Integer accountId;
+    private String security;
+    private String side;
+    private Integer quantity;
+    private BigDecimal limitPrice;
+    private String reason;
+    private Instant rejectedAt;
+
+    public static RejectedOrder from(OrderCreateRequest request, String reason) {
+        RejectedOrder rejected = new RejectedOrder();
+        rejected.rejectionId = "rej-" + UUID.randomUUID();
+        if (request != null) {
+            rejected.accountId = request.getAccountId();
+            rejected.security = request.getSecurity();
+            rejected.side = request.getSide() == null ? null : request.getSide().name();
+            rejected.quantity = request.getQuantity();
+            rejected.limitPrice = request.getLimitPrice();
+        }
+        rejected.reason = reason;
+        rejected.rejectedAt = Instant.now();
+        return rejected;
+    }
+
+    public String getRejectionId() {
+        return rejectionId;
+    }
+
+    public Integer getAccountId() {
+        return accountId;
+    }
+
+    public String getSecurity() {
+        return security;
+    }
+
+    public String getSide() {
+        return side;
+    }
+
+    public Integer getQuantity() {
+        return quantity;
+    }
+
+    public BigDecimal getLimitPrice() {
+        return limitPrice;
+    }
+
+    public String getReason() {
+        return reason;
+    }
+
+    public Instant getRejectedAt() {
+        return rejectedAt;
+    }
+}
