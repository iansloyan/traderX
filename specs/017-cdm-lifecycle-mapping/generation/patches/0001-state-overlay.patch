diff --git a/web-front-end/angular/main/app/cdm/_cdm-common.scss b/web-front-end/angular/main/app/cdm/_cdm-common.scss
new file mode 100644
index 0000000..faf7cfd
--- /dev/null
+++ b/web-front-end/angular/main/app/cdm/_cdm-common.scss
@@ -0,0 +1,49 @@
+// Styles shared by the CDM views (cdm-view and cdm-home); kept small: each component's style budget is 4 kB.
+.cdm-view-container { min-height: calc(100vh - 130px); }
+.cdm-id, .cdm-ref { font-size: 0.9rem; }
+.cdm-ref { color: #6c757d; }
+
+.cdm-stat {
+  border: 1px solid #dee2e6;
+  border-radius: 6px;
+  padding: 6px 10px;
+  background: #f8f9fa;
+  display: flex;
+  flex-direction: column;
+
+  .cdm-stat-label {
+    font-size: 0.72rem;
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+    color: #6c757d;
+  }
+
+  strong { font-variant-numeric: tabular-nums; font-size: 1.05rem; }
+}
+
+.cdm-section-title {
+  font-size: 0.78rem;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: #6c757d;
+  margin-bottom: 8px;
+}
+
+.cdm-badge {
+  display: inline-block;
+  padding: 1px 6px;
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.03em;
+  border-radius: 4px;
+  line-height: 1.4;
+  cursor: help;
+}
+
+.cdm-badge-valid { background: #d1e7dd; color: #0f5132; }
+.cdm-badge-invalid { background: #f8d7da; color: #842029; }
+.cdm-badge-not-qualified { background: #fff3cd; color: #664d03; }
+.cdm-badge-pending { background: #cff4fc; color: #055160; }
+.cdm-badge-unknown { background: #e9ecef; color: #495057; }
+
+.cdm-table { font-size: 0.8rem; }
diff --git a/web-front-end/angular/main/app/cdm/cdm-home.component.html b/web-front-end/angular/main/app/cdm/cdm-home.component.html
