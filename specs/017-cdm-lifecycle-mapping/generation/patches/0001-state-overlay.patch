+++ b/web-front-end/angular/main/app/cdm/cdm.service.spec.ts
@@ -0,0 +1,95 @@
+import { TestBed } from '@angular/core/testing';
+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { CdmResult, CdmService } from './cdm.service';
+
+describe('CdmService', () => {
+    let service: CdmService;
+    let http: HttpTestingController;
+
+    beforeEach(() => {
+        TestBed.configureTestingModule({
+            providers: [provideHttpClient(), provideHttpClientTesting()]
+        });
+        service = TestBed.inject(CdmService);
+        http = TestBed.inject(HttpTestingController);
+    });
+
+    afterEach(() => http.verify());
+
+    it('maps 404 {"status":"pending"} to a pending result', () => {
+        let result: CdmResult<any> | undefined;
+        service.orderLineage('ord-017-0001').subscribe((r) => (result = r));
+
+        const req = http.expectOne((r) => r.url.endsWith('/cdm-service/cdm/orders/ord-017-0001/lineage'));
+        req.flush({ cdmRef: 'cdm:order:ord-017-0001', status: 'pending' }, { status: 404, statusText: 'Not Found' });
+
+        expect(result).toEqual({ status: 'pending', cdmRef: 'cdm:order:ord-017-0001' });
+    });
+
+    it('maps a pending body sent as text to a pending result', () => {
+        let result: CdmResult<any> | undefined;
+        service.tradeLineage('trd-1').subscribe((r) => (result = r));
+
+        http.expectOne((r) => r.url.endsWith('/cdm/trades/trd-1/lineage'))
+            .flush('{"cdmRef":"cdm:trade:trd-1","status":"pending"}', { status: 404, statusText: 'Not Found' });
+
+        expect(result).toEqual({ status: 'pending', cdmRef: 'cdm:trade:trd-1' });
+    });
+
+    it('wraps a 200 answer as ok', () => {
+        let result: CdmResult<any> | undefined;
+        service.trade('trd-1').subscribe((r) => (result = r));
+
+        http.expectOne((r) => r.url.endsWith('/cdm/trades/trd-1')).flush({ cdmRef: 'cdm:trade:trd-1', tradeState: null, producedBy: null });
+
+        expect(result).toEqual({ status: 'ok', data: { cdmRef: 'cdm:trade:trd-1', tradeState: null, producedBy: null } as any });
+    });
+
+    it('reads the account positions with their trade states', () => {
+        let result: CdmResult<any> | undefined;
+        service.positions(22214).subscribe((r) => (result = r));
+
+        const trades = [
+            { tradeId: 'trd-1', cdmRef: 'cdm:trade:trd-1', signedQuantity: 750, price: 179.5, side: 'Buy', executedAt: '2026-10-29T14:30:05Z' },
+            { tradeId: 'trd-9', cdmRef: 'cdm:trade:trd-9', signedQuantity: 50, price: 180, side: 'Buy', executedAt: 'null' }
+        ];
+        http.expectOne((r) => r.url.endsWith('/cdm-service/cdm/positions/22214'))
+            .flush({ cdmRef: 'cdm:position:22214', positions: [{ cdmRef: 'cdm:position:22214:IBM', security: 'IBM', quantity: 800, trades }] });
+
+        expect(result?.status).toBe('ok');
+        const data = result?.status === 'ok' ? result.data : null;
+        expect(data.positions[0].quantity).toBe(800);
+        expect(data.positions[0].trades).toEqual(trades);
+    });
+
+    it('maps positions of an account without CDM trades (404 pending) to a pending result', () => {
+        let result: CdmResult<any> | undefined;
+        service.positions(22215).subscribe((r) => (result = r));
+
+        http.expectOne((r) => r.url.endsWith('/cdm/positions/22215'))
+            .flush({ cdmRef: 'cdm:position:22215', status: 'pending' }, { status: 404, statusText: 'Not Found' });
+
+        expect(result).toEqual({ status: 'pending', cdmRef: 'cdm:position:22215' });
+    });
+
+    it('propagates a 404 that is not pending and other errors', () => {
+        let notFound: any;
+        let unavailable: any;
+        service.orderLineage('x').subscribe({ error: (e) => (notFound = e) });
+        service.orderLineage('y').subscribe({ error: (e) => (unavailable = e) });
+
+        http.expectOne((r) => r.url.endsWith('/orders/x/lineage')).flush({ error: 'nope' }, { status: 404, statusText: 'Not Found' });
+        http.expectOne((r) => r.url.endsWith('/orders/y/lineage')).flush('starting', { status: 503, statusText: 'Service Unavailable' });
+
+        expect(notFound?.status).toBe(404);
+        expect(unavailable?.status).toBe(503);
+    });
+
+    it('encodes ids in the path', () => {
+        let result: CdmResult<any> | undefined;
+        service.orderLineage('rej-1/2').subscribe((r) => (result = r));
+        http.expectOne((r) => r.url.endsWith('/cdm/orders/rej-1%2F2/lineage')).flush({});
+        expect(result?.status).toBe('ok');
+    });
+});
diff --git a/web-front-end/angular/main/app/cdm/cdm.service.ts b/web-front-end/angular/main/app/cdm/cdm.service.ts
new file mode 100644
index 0000000..69ecae7
