+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.client.RestTemplate;
+import org.springframework.web.server.ResponseStatusException;
+
+/** State 017 (Ruling R36): admin force-fill with an optional quantity. */
+class OrderMatcherServiceForceFillTest {
+    private OrderRepository repository;
+    private RestTemplate restTemplate;
+    private OrderMatcherService service;
+    private OrderRecord order;
+
+    @BeforeEach
+    @SuppressWarnings("unchecked")
+    void setUp() {
+        repository = mock(OrderRepository.class);
+        restTemplate = mock(RestTemplate.class);
+        when(repository.save(any(OrderRecord.class))).thenAnswer(call -> call.getArgument(0));
+        when(restTemplate.postForEntity(anyString(), any(), eq(Map.class))).thenReturn(ResponseEntity.ok(Map.of()));
+        service = new OrderMatcherService(repository, mock(Publisher.class), mock(Publisher.class), restTemplate,
+            false, "", "http://price", "http://trade-service/trade/", 1000, 1000);
+        order = new OrderRecord();
+        order.setOrderId("ord-013-0042");
+        order.setAccountId(22214);
+        order.setSecurity("IBM");
+        order.setSide(OrderSide.Buy);
+        order.setQuantity(1500);
+        order.setRemainingQuantity(1500);
+        order.setLimitPrice(new BigDecimal("90.000"));
+        order.setStatus(OrderStatus.NEW);
+        order.setCreatedAt(Instant.now());
+        order.setUpdatedAt(Instant.now());
+        when(repository.findById("ord-013-0042")).thenReturn(Optional.of(order));
+    }
+
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    private int submittedQuantity() {
+        ArgumentCaptor<Object> body = ArgumentCaptor.forClass(Object.class);
+        verify(restTemplate).postForEntity(eq("http://trade-service/trade/"), body.capture(), eq(Map.class));
+        return (Integer) ((Map<String, Object>) body.getValue()).get("quantity");
+    }
+
+    @Test
+    void partialForceFillFillsRequestedQuantity() {
+        OrderResponse response = service.forceFillOrder("ord-013-0042", 750);
+
+        assertEquals(750, submittedQuantity());
+        assertEquals(OrderStatus.PARTIALLY_FILLED, response.getStatus());
+        assertEquals(750, response.getRemainingQuantity());
+        assertEquals(750, response.getFilledQuantity());
+        assertEquals(750, response.getLastFillQuantity());
+    }
+
+    @Test
+    void forceFillWithoutQuantityIsUnchanged() {
+        OrderResponse response = service.forceFillOrder("ord-013-0042");
+
+        assertEquals(1500, submittedQuantity());
+        assertEquals(OrderStatus.FILLED, response.getStatus());
+        assertEquals(0, response.getRemainingQuantity());
+        assertEquals(1500, response.getFilledQuantity());
+
+        // The explicit null overload is the same path.
+        order.setRemainingQuantity(1500);
+        order.setStatus(OrderStatus.NEW);
+        assertEquals(OrderStatus.FILLED, service.forceFillOrder("ord-013-0042", null).getStatus());
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void forceFillQuantityOutOfRangeIsBadRequest() {
+        for (int quantity : new int[] {0, -1, 1501}) {
+            ResponseStatusException thrown = assertThrows(ResponseStatusException.class,
+                () -> service.forceFillOrder("ord-013-0042", quantity));
+            assertEquals(400, thrown.getStatusCode().value(), "quantity " + quantity);
+        }
+        order.setStatus(OrderStatus.CANCELED);
+        order.setRemainingQuantity(0);
+        assertEquals(400, assertThrows(ResponseStatusException.class,
+            () -> service.forceFillOrder("ord-013-0042", 1)).getStatusCode().value());
+        verify(restTemplate, never()).postForEntity(anyString(), any(), eq(Map.class));
+        assertEquals(1500, order.getQuantity());
+    }
+}
