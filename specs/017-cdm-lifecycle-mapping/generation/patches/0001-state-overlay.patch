+
+    it('computes row badges from the fill-nested lineage shape', () => {
+        const step = (key: string, status = 'VALID') => ({
+            storeGlobalKey: key, cdmGlobalKey: key, previousStoreGlobalKey: null, cdmType: 'cdm.event.workflow.WorkflowStep',
+            validation: { status, messages: status === 'VALID' ? [] : ['bad'] }, stepType: 'proposed', timestamp: null
+        });
+        const orderAdmin = TestBed.inject(OrderAdminService) as jasmine.SpyObj<OrderAdminService>;
+        orderAdmin.getOrders.and.returnValue(of([{ orderId: 'ord-1', updatedAt: '2026-10-29T10:00:00Z' } as any]));
+        cdm.orderLineage.and.returnValue(of({
+            status: 'ok',
+            data: {
+                status: 'filled', failures: [],
+                proposal: { versions: [step('k1'), step('k2')] },
+                fills: [{ proposed: step('f1p'), accepted: step('f1a', 'NOT_QUALIFIED'), tradeState: { validation: { status: 'VALID', messages: [] } } }],
+                cancel: null
