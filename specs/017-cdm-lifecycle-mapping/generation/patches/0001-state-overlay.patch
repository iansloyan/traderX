+
+        expect(cdm.setServicingParty).toHaveBeenCalledWith(22214, 'traderx-tky');
+        const tky = root.querySelector('.cdm-relationships tr[data-entity="traderx-tky"]');
+        expect(text(tky)).toContain('Test Account 20 (22214)');
