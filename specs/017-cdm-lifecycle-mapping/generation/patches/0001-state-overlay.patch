@@ -0,0 +1,281 @@
+import { Component, OnDestroy, OnInit } from '@angular/core';
+import { ActivatedRoute, Router } from '@angular/router';
+import { from, of, Subscription } from 'rxjs';
+import { catchError, map, mergeMap } from 'rxjs/operators';
+import { Account } from '../model/account.model';
+import { OrderRecord } from '../model/order.model';
+import { Trade } from '../model/trade.model';
+import { AccountService } from '../service/account.service';
+import { OrderAdminService } from '../service/order-admin.service';
+import { PositionService } from '../service/position.service';
+import { CdmPosition, CdmPositions, CdmRejection, CdmService, CdmValidation, CdmValidationSummary } from './cdm.service';
+import { badgeClass, cdmViewPath, partyView, PartyView, formatPrice, formatQuantity, isoTimeOrNull, worstValidation } from './cdm-presentation';
+
+/** Validation badge of one row: the worst result over the row's stored CDM objects. */
+export interface RowBadge {
+    status: string;
+    lineageStatus: string | null;
+    title: string;
+}
+
+/**
+ * CDM overview (`/cdm`): validation summary across cdm-service, then for the selected account its
+ * recent orders and trades (each with the worst validation result of its CDM lineage and a link to
+ * the lineage view), its positions (each with the trade states that sum to it) and its rejected
+ * order requests.
+ */
+@Component({
+    standalone: false,
+    selector: 'app-cdm-home',
+    templateUrl: './cdm-home.component.html',
+    styleUrls: ['./cdm-home.component.scss']
+})
+export class CdmHomeComponent implements OnInit, OnDestroy {
+    static readonly DEFAULT_ACCOUNT_ID = 22214;
+    static readonly ROW_LIMIT = 15;
+    static readonly BADGE_CONCURRENCY = 4;
+
+    accounts: Account[] = [];
+    account?: Account;
+    summary: CdmValidationSummary | null = null;
+    summaryError = false;
+    orders: OrderRecord[] = [];
+    trades: Trade[] = [];
+    rejections: CdmRejection[] = [];
+    positions: CdmPositions | null = null;
+    positionsError = false;
+    /** cdm-service has no PortfolioState for the account: it has no CDM trades yet (a normal state, not an error). */
+    positionsPending = false;
+    expandedPositions = new Set<string>();
+    orderBadges: { [orderId: string]: RowBadge } = {};
+    tradeBadges: { [tradeId: string]: RowBadge } = {};
+    loadingRows = false;
+    /** TraderX subsidiaries that can service a client (CDM parties), in seed order. */
+    entities: PartyView[] = [];
+    servicingSaving = false;
+    servicingError: string | null = null;
+
+    readonly badgeClass = badgeClass;
+    readonly formatQuantity = formatQuantity;
+    readonly formatPrice = formatPrice;
+    readonly cdmViewPath = cdmViewPath;
+    readonly isoTimeOrNull = isoTimeOrNull;
+
+    private subs: Subscription[] = [];
+    private scopeSubs: Subscription[] = [];
+
+    constructor(
+        private cdm: CdmService,
+        private accountService: AccountService,
+        private orderAdminService: OrderAdminService,
+        private positionService: PositionService,
+        private route: ActivatedRoute,
+        private router: Router
+    ) {}
+
+    ngOnInit(): void {
+        this.subs.push(this.cdm.validationSummary().subscribe({
+            next: (summary) => (this.summary = summary),
+            error: () => (this.summaryError = true)
+        }));
+        this.subs.push(this.cdm.entities().pipe(catchError(() => of([] as any[]))).subscribe((entities) => {
+            this.entities = (entities ?? []).map((entity) => partyView(entity))
+                .filter((entity): entity is PartyView => entity != null);
+        }));
+        this.subs.push(this.accountService.getAccounts().subscribe((accounts) => {
+            this.accounts = accounts ?? [];
+            const requested = Number(this.route.snapshot.queryParamMap.get('accountId'));
+            const pick = this.accounts.find((a) => a.id === requested)
+                ?? this.accounts.find((a) => a.id === CdmHomeComponent.DEFAULT_ACCOUNT_ID)
+                ?? this.accounts[0];
+            if (pick) {
+                this.selectAccount(pick, false);
+            }
+        }));
+    }
+
+    ngOnDestroy(): void {
+        this.subs.forEach((sub) => sub.unsubscribe());
+        this.scopeSubs.forEach((sub) => sub.unsubscribe());
+    }
+
+    onAccountChange(account: Account): void {
+        this.selectAccount(account, true);
+    }
+
+    /** Key of the subsidiary servicing an account (from its servicingPartyRef cdm:party:<key>). */
+    servicingKey(account: Account | undefined): string | null {
+        const ref = account?.servicingPartyRef;
+        return ref ? ref.replace(/^cdm:party:/, '') : null;
+    }
+
+    /** Each subsidiary with the clients it services (the trading relationships), then any unassigned accounts. */
+    relationships(): { key: string | null; name: string; accounts: Account[] }[] {
+        const rows = this.entities.map((entity) => ({
+            key: entity.externalKey,
+            name: entity.name ?? entity.externalKey ?? '-',
+            accounts: this.accounts.filter((account) => this.servicingKey(account) === entity.externalKey)
+        }));
+        const known = new Set(rows.map((row) => row.key));
+        const others = this.accounts.filter((account) => !known.has(this.servicingKey(account)));
+        return others.length ? [...rows, { key: null, name: 'Not assigned', accounts: others }] : rows;
+    }
+
+    /** Makes another subsidiary service the selected account; later orders and trades face it. */
+    changeServicingEntity(entity: string, select?: HTMLSelectElement): void {
+        const account = this.account;
+        if (!account || !entity || entity === this.servicingKey(account)) {
+            return;
+        }
+        this.servicingSaving = true;
+        this.servicingError = null;
+        this.subs.push(this.cdm.setServicingParty(account.id, entity).subscribe({
+            next: () => {
+                const name = this.entities.find((e) => e.externalKey === entity)?.name ?? entity;
+                const updated: Account = { ...account, servicingPartyRef: `cdm:party:${entity}`, servicingPartyName: name };
+                this.accounts = this.accounts.map((a) => (a.id === account.id ? updated : a));
+                this.account = updated;
+                this.servicingSaving = false;
+            },
+            error: () => {
+                this.servicingError = 'Could not change the servicing subsidiary';
+                this.servicingSaving = false;
+                // the select shows the user's choice; put it back to the subsidiary that still applies
+                if (select) {
+                    select.value = this.servicingKey(account) ?? '';
+                }
+            }
+        }));
+    }
+
+    countOf(status: string): number {
+        return this.summary?.objects?.byStatus?.[status] ?? 0;
+    }
+
+    togglePosition(position: CdmPosition): void {
+        if (this.expandedPositions.has(position.security)) {
+            this.expandedPositions.delete(position.security);
+        } else {
+            this.expandedPositions.add(position.security);
+        }
+    }
+
+    /** Sum of the signed quantities of the trade states listed under a position. */
+    tradeSum(position: CdmPosition): number {
+        return (position.trades ?? []).reduce((sum, trade) => sum + (trade.signedQuantity ?? 0), 0);
+    }
+
+    private selectAccount(account: Account, updateUrl: boolean): void {
+        this.account = account;
+        if (updateUrl) {
+            this.router.navigate([], { relativeTo: this.route, queryParams: { accountId: account.id }, replaceUrl: true });
+        }
+        this.loadScope(account.id);
+    }
+
+    private loadScope(accountId: number): void {
+        this.scopeSubs.forEach((sub) => sub.unsubscribe());
+        this.scopeSubs = [];
+        this.orders = [];
+        this.trades = [];
+        this.rejections = [];
+        this.positions = null;
+        this.positionsError = false;
+        this.positionsPending = false;
+        this.expandedPositions.clear();
+        this.orderBadges = {};
+        this.tradeBadges = {};
+        this.loadingRows = true;
+
+        this.scopeSubs.push(this.orderAdminService.getOrders(accountId, 'all').pipe(catchError(() => of([] as OrderRecord[])))
+            .subscribe((orders) => {
+                this.orders = [...(orders ?? [])]
+                    .sort((a, b) => this.epoch(b.updatedAt) - this.epoch(a.updatedAt))
+                    .slice(0, CdmHomeComponent.ROW_LIMIT);
+                this.loadingRows = false;
+                this.loadOrderBadges(this.orders.map((order) => order.orderId));
+            }));
+        this.scopeSubs.push(this.positionService.getTrades(accountId).pipe(catchError(() => of([] as Trade[])))
+            .subscribe((trades) => {
+                this.trades = [...(trades ?? [])]
+                    .sort((a, b) => this.epoch(b.created) - this.epoch(a.created))
+                    .slice(0, CdmHomeComponent.ROW_LIMIT);
+                this.loadTradeBadges(this.trades.map((trade) => trade.id));
+            }));
+        this.scopeSubs.push(this.cdm.positions(accountId).subscribe({
+            next: (result) => {
+                this.positions = result.status === 'ok' ? result.data : null;
+                this.positionsPending = result.status === 'pending';
+            },
+            error: () => (this.positionsError = true)
+        }));
+        this.scopeSubs.push(this.cdm.rejections(accountId).pipe(catchError(() => of(null)))
+            .subscribe((result) => {
+                this.rejections = [...(result?.rejections ?? [])].reverse(); // newest first
+            }));
+    }
+
+    private loadOrderBadges(orderIds: string[]): void {
+        this.scopeSubs.push(from(orderIds).pipe(
+            mergeMap((orderId) => this.cdm.orderLineage(orderId).pipe(
+                map((result): [string, RowBadge] => {
+                    if (result.status === 'pending') {
+                        return [orderId, { status: 'pending', lineageStatus: null, title: 'CDM record is being built' }];
+                    }
+                    const lineage = result.data;
+                    // the order's versions, each fill's two steps and trade state, and the cancel
+                    const results: (CdmValidation | null)[] = [
+                        ...(lineage.proposal?.versions ?? []).map((step) => step.validation),
+                        ...(lineage.fills ?? []).flatMap((fill) => [
+                            fill.proposed?.validation ?? null,
+                            fill.accepted?.validation ?? null,
+                            fill.tradeState?.validation ?? null
+                        ]),
+                        lineage.cancel?.validation ?? null
+                    ];
+                    const failures = lineage.failures?.length ?? 0;
+                    return [orderId, this.badge(results, lineage.status, failures)];
+                }),
+                catchError(() => of<[string, RowBadge]>([orderId, { status: 'error', lineageStatus: null, title: 'cdm-service error' }]))
+            ), CdmHomeComponent.BADGE_CONCURRENCY)
+        ).subscribe(([orderId, badge]) => (this.orderBadges = { ...this.orderBadges, [orderId]: badge })));
+    }
+
+    private loadTradeBadges(tradeIds: string[]): void {
+        this.scopeSubs.push(from(tradeIds).pipe(
+            mergeMap((tradeId) => this.cdm.tradeLineage(tradeId).pipe(
+                map((result): [string, RowBadge] => {
+                    if (result.status === 'pending') {
+                        return [tradeId, { status: 'pending', lineageStatus: null, title: 'CDM record is being built' }];
+                    }
+                    const lineage = result.data;
+                    // the trade state, then the two steps of the workflow that produced it
+                    const results: (CdmValidation | null)[] = [
+                        lineage.tradeState?.validation ?? null,
+                        lineage.producedBy?.proposed?.validation ?? null,
+                        lineage.producedBy?.accepted?.validation ?? null
+                    ];
+                    return [tradeId, this.badge(results, lineage.producedBy?.kind ?? 'unknown', 0)];
+                }),
+                catchError(() => of<[string, RowBadge]>([tradeId, { status: 'error', lineageStatus: null, title: 'cdm-service error' }]))
+            ), CdmHomeComponent.BADGE_CONCURRENCY)
+        ).subscribe(([tradeId, badge]) => (this.tradeBadges = { ...this.tradeBadges, [tradeId]: badge })));
+    }
+
+    private badge(results: (CdmValidation | null)[], lineageStatus: string | null, failures: number): RowBadge {
+        const worst = worstValidation(results);
+        const count = results.filter(Boolean).length;
+        const messages = worst?.messages?.length ? `: ${worst.messages.join('; ')}` : '';
+        return {
+            status: worst?.status ?? 'unknown',
+            lineageStatus,
+            title: `${count} CDM object(s) validated, worst ${worst?.status ?? 'n/a'}${messages}`
+                + (failures ? `; ${failures} lifecycle failure(s)` : '')
+        };
+    }
+
+    private epoch(value: string | Date | undefined): number {
+        const ts = value ? new Date(value).getTime() : 0;
+        return Number.isFinite(ts) ? ts : 0;
+    }
+}
diff --git a/web-front-end/angular/main/app/cdm/cdm-presentation.ts b/web-front-end/angular/main/app/cdm/cdm-presentation.ts
new file mode 100644
index 0000000..f046ab0
--- /dev/null
+++ b/web-front-end/angular/main/app/cdm/cdm-presentation.ts
@@ -0,0 +1,271 @@
+import { CdmValidation } from './cdm.service';
+
+/**
+ * Pure helpers that read the bits of FINOS CDM (Rosetta JSON) the CDM view displays. The Rune
+ * serialiser writes a single-element list either as an array or as the element itself, so every
+ * list access goes through {@link first}.
+ */
+
+export const ACCOUNT_ID_SCHEME = 'https://traderx.finos.org/account-id';
+export const LOGON_ID_SCHEME = 'https://traderx.finos.org/logon-id';
+export const DEMO_IDENTIFIER_SCHEME = 'https://traderx.finos.org/demo-identifier';
+export const VENUE_KEY = 'traderx-matching-engine';
+
+export function first(value: any): any {
+    if (Array.isArray(value)) {
+        return value.length > 0 ? value[0] : undefined;
+    }
+    return value ?? undefined;
+}
+
+export function asList(value: any): any[] {
+    if (value == null) {
+        return [];
+    }
+    return Array.isArray(value) ? value : [value];
+}
+
+/** Unwraps Rune `FieldWithMeta` / `ReferenceWithMeta` value holders (`{value: ...}`). */
+export function unwrap(value: any): any {
+    let current = value;
+    while (current && typeof current === 'object' && !Array.isArray(current) && 'value' in current
+        && Object.keys(current).every((key) => key === 'value' || key === 'meta')) {
+        current = current.value;
+    }
+    return current;
+}
+
+export function toNumber(value: any): number | null {
+    if (value == null || value === '') {
+        return null;
+    }
+    const numeric = Number(value);
+    return Number.isFinite(numeric) ? numeric : null;
+}
+
+/** The first value found under any object of `root` that `pick` accepts (depth-first). */
+export function deepFind<T>(root: any, pick: (node: any) => T | undefined): T | undefined {
+    const stack: any[] = [root];
+    const seen = new Set<any>();
+    while (stack.length > 0) {
+        const node = stack.pop();
+        if (!node || typeof node !== 'object' || seen.has(node)) {
+            continue;
+        }
+        seen.add(node);
+        const found = pick(node);
+        if (found !== undefined) {
+            return found;
+        }
+        const children = Array.isArray(node) ? node : Object.values(node);
+        for (let i = children.length - 1; i >= 0; i--) {
+            stack.push(children[i]);
+        }
+    }
+    return undefined;
+}
+
+/** The TraderX account id of the first Party carrying an account-id identifier. */
+export function findAccountId(root: any): number | undefined {
+    return deepFind(root, (node) => {
+        if (!node.partyId) {
+            return undefined;
+        }
+        for (const partyId of asList(node.partyId)) {
+            const identifier = partyId?.identifier;
+            if (identifier?.meta?.scheme === ACCOUNT_ID_SCHEME) {
+                const id = toNumber(identifier.value);
+                return id == null ? undefined : id;
+            }
+        }
+        return undefined;
+    });
+}
+
+/** The ticker: the first `ExchangeCode` asset identifier. */
+export function findTicker(root: any): string | undefined {
+    return deepFind(root, (node) => {
+        if (node.identifierType === 'ExchangeCode' && node.identifier?.value) {
+            return String(node.identifier.value);
+        }
+        return undefined;
+    });
+}
+
+export interface PartyIdentifierView {
+    value: string;
+    scheme: string | null;
+}
+
+export interface PersonView {
+    key: string | null;
+    name: string;
+    logonId: string | null;
+    email: string | null;
+    roles: string[];
+    identifiers: PartyIdentifierView[];
+}
+
+export interface PartyView {
+    name: string | null;
+    externalKey: string | null;
+    identifiers: PartyIdentifierView[];
+    persons: PersonView[];
+    /** Key of the TraderX subsidiary servicing an account party (CDM Account.servicingParty), if any. */
+    servicingEntity: string | null;
+}
+
+/** CDM Party → display model (identifiers, related persons with their roles). */
+export function partyView(party: any): PartyView | null {
+    if (!party || typeof party !== 'object') {
+        return null;
+    }
+    const rolesByPerson = new Map<string, string[]>();
+    for (const personRole of asList(party.personRole)) {
+        const key = personRole?.personReference?.externalReference ?? personRole?.personReference?.globalReference;
+        if (!key) {
+            continue;
+        }
+        const roles = asList(personRole.role).map((role) => String(unwrap(role))).filter(Boolean);
+        rolesByPerson.set(key, [...(rolesByPerson.get(key) ?? []), ...roles]);
+    }
+    const persons: PersonView[] = asList(party.person).map((person) => {
+        const identifiers = asList(person?.personId).map((personId) => {
+            const identifier = unwrap(personId)?.identifier ?? personId?.identifier;
+            return {
+                value: String(identifier?.value ?? ''),
+                scheme: identifier?.meta?.scheme ?? (unwrap(personId)?.identifierType ?? null)
+            };
+        }).filter((identifier) => identifier.value);
+        const key = person?.meta?.externalKey ?? null;
+        const logonId = identifiers.find((identifier) => identifier.scheme === LOGON_ID_SCHEME)?.value ?? key;
+        const name = [person?.firstName, person?.surname].filter(Boolean).join(' ') || logonId || 'unnamed person';
+        return {
+            key,
+            name,
+            logonId,
+            email: first(person?.contactInformation?.email) ?? null,
+            roles: key ? rolesByPerson.get(key) ?? [] : [],
+            identifiers
+        };
+    });
+    return {
+        name: unwrap(party.name) ?? null,
+        externalKey: party.meta?.externalKey ?? null,
+        identifiers: asList(party.partyId).map((partyId) => ({
+            value: String(partyId?.identifier?.value ?? ''),
+            scheme: partyId?.identifier?.meta?.scheme ?? null
+        })).filter((identifier) => identifier.value),
+        persons,
+        servicingEntity: party.account?.servicingParty?.externalReference ?? null
+    };
+}
+
+export interface SecurityIdentifierView {
+    type: string;
+    value: string;
+    scheme: string | null;
+    demo: boolean;
+}
+
+export interface SecurityView {
+    ticker: string | null;
+    assetType: string | null;
+    securityType: string | null;
+    equityType: string | null;
+    identifiers: SecurityIdentifierView[];
+}
+
+/** CDM Security → display model. ISIN and FIGI are synthetic in TraderX and flagged `demo`. */
+export function securityView(security: any): SecurityView | null {
+    if (!security || typeof security !== 'object') {
+        return null;
+    }
+    const identifiers = asList(security.identifier).map((assetIdentifier) => {
+        const type = String(assetIdentifier?.identifierType ?? 'Other');
+        const scheme = assetIdentifier?.identifier?.meta?.scheme ?? null;
+        return {
+            type,
+            value: String(assetIdentifier?.identifier?.value ?? ''),
+            scheme,
+            demo: type === 'ISIN' || type === 'FIGI' || scheme === DEMO_IDENTIFIER_SCHEME
+        };
+    }).filter((identifier) => identifier.value);
+    return {
+        ticker: identifiers.find((identifier) => identifier.type === 'ExchangeCode')?.value ?? null,
+        assetType: security.assetType ?? null,
+        securityType: security.securityType ?? null,
+        equityType: security.equityType?.equityType ?? null,
+        identifiers
+    };
+}
+
+const VALIDATION_RANK: { [status: string]: number } = { VALID: 0, NOT_QUALIFIED: 1, INVALID: 2 };
+
+/** The worst of several validation results (INVALID > NOT_QUALIFIED > VALID); null if none. */
+export function worstValidation(results: (CdmValidation | null | undefined)[]): CdmValidation | null {
+    let worst: CdmValidation | null = null;
+    for (const result of results) {
+        if (!result) {
+            continue;
+        }
+        if (!worst || (VALIDATION_RANK[result.status] ?? 3) > (VALIDATION_RANK[worst.status] ?? 3)) {
+            worst = result;
+        }
+    }
+    return worst;
+}
+
+export function badgeClass(status: string | null | undefined): string {
+    switch (status) {
+        case 'VALID':
+            return 'cdm-badge cdm-badge-valid';
+        case 'INVALID':
+            return 'cdm-badge cdm-badge-invalid';
+        case 'NOT_QUALIFIED':
+            return 'cdm-badge cdm-badge-not-qualified';
+        case 'pending':
+            return 'cdm-badge cdm-badge-pending';
+        default:
+            return 'cdm-badge cdm-badge-unknown';
+    }
+}
+
+export function formatQuantity(value: number | null | undefined): string {
+    if (value == null) {
+        return '-';
+    }
+    return new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(value);
+}
+
+export function formatPrice(value: number | null | undefined): string {
+    if (value == null) {
+        return '-';
+    }
+    return new Intl.NumberFormat('en-US', {
+        style: 'currency',
+        currency: 'USD',
+        minimumFractionDigits: 3,
+        maximumFractionDigits: 3
+    }).format(value);
+}
+
+/** An ISO time, or null for a missing or unparseable one (cdm-service may send the string "null"). */
+export function isoTimeOrNull(value: string | null | undefined): string | null {
+    if (value == null || value === '' || value === 'null') {
+        return null;
+    }
+    return Number.isFinite(new Date(value).getTime()) ? value : null;
+}
+
+/** The order / trade id of a `cdm:<kind>:<key>` ref, if it is of that kind. */
+export function refKey(cdmRef: string | null | undefined, kind: string): string | null {
+    const prefix = `cdm:${kind}:`;
+    return cdmRef && cdmRef.startsWith(prefix) ? cdmRef.substring(prefix.length) : null;
+}
+
+/** Router path of the CDM view for an order or trade row; prefers the row's own `cdmRef`. */
+export function cdmViewPath(kind: 'order' | 'trade', id: string, cdmRef?: string | null): string[] {
+    const key = refKey(cdmRef, kind) ?? id;
+    return ['/cdm', kind, key];
+}
