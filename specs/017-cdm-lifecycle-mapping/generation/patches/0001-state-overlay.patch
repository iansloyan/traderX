+using System.Net;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Microsoft.Extensions.DependencyInjection;
+using PeopleService.WebApi.Directory;
+
+namespace PeopleService.Tests;
+
+public sealed class PeopleControllerTests
+{
+    private const string Alice = """
+        {"logonId":"user01","fullName":"Alice Johnson","email":"alice.johnson@example.com",
+         "employeeId":"E0001","department":"HR","photoUrl":"https://example.com/photos/user01.jpg",
+         "cdmRef":"cdm:person:user01"}
+        """;
+
+    private const string Bob = """
+        {"logonId":"user02","fullName":"Bob Smith","email":"bob.smith@example.com",
+         "employeeId":"E0002","department":"Finance","photoUrl":"https://example.com/photos/user02.jpg",
+         "cdmRef":"cdm:person:user02"}
+        """;
+
+    private const string Carol = """
+        {"logonId":"user03","fullName":"Carol Brown","email":"carol.brown@example.com",
+         "employeeId":"E0003","department":"IT","photoUrl":"https://example.com/photos/user03.jpg",
+         "cdmRef":"cdm:person:user03"}
+        """;
+
+    private readonly StubCdmService _cdm = new();
+
+    private HttpClient Client() => new PeopleApiFactory(_cdm).CreateClient();
+
+    private static async Task<JsonNode> Body(HttpResponseMessage response) =>
+        JsonNode.Parse(await response.Content.ReadAsStringAsync())!;
+
+    [Fact]
+    public async Task GetPerson_ReturnsCdmRef()
+    {
+        _cdm.Respond = req => req.RequestUri!.AbsolutePath == "/projections/people/user01"
+            ? StubCdmService.Json(Alice)
+            : new HttpResponseMessage(HttpStatusCode.NotFound);
+
+        var response = await Client().GetAsync("/People/GetPerson?LogonId=user01");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = (JsonObject)await Body(response);
+        // Every 009 field, same camelCase names, plus the optional cdmRef.
+        Assert.Equal(
+            ["logonId", "fullName", "email", "employeeId", "department", "photoUrl", "cdmRef"],
+            body.Select(p => p.Key).ToArray());
+        Assert.True(JsonNode.DeepEquals(JsonNode.Parse(Alice), body));
+        Assert.Equal("cdm:person:user01", (string?)body["cdmRef"]);
+    }
+
+    [Fact]
+    public async Task GetPerson_ByEmployeeIdAsksCdmServiceForThatEmployee()
+    {
+        _cdm.Respond = req => req.RequestUri!.Query == "?employeeId=E0002"
+            ? StubCdmService.Json($"[{Bob}]")
+            : StubCdmService.Json("[]");
+
+        var found = await Client().GetAsync("/People/GetPerson?EmployeeId=E0002");
+        var missing = await Client().GetAsync("/People/GetPerson?EmployeeId=E9999");
+
+        Assert.Equal(HttpStatusCode.OK, found.StatusCode);
+        Assert.Equal("user02", (string?)(await Body(found))["logonId"]);
+        Assert.Equal(HttpStatusCode.NotFound, missing.StatusCode);
+        Assert.All(_cdm.Requests, uri => Assert.Equal("/projections/people", uri.AbsolutePath));
+    }
+
+    [Fact]
+    public async Task GetPerson_UnknownOrIdentifierOnlyPersonIs404()
+    {
+        // cdm-service answers 404 for unknown and for identifier-only persons (Ruling R20).
+        var response = await Client().GetAsync("/People/GetPerson?LogonId=adhoc1");
+
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
