+        expect(text(rows[0].querySelector('.cdm-position-toggle'))).toContain('3 trade states');
+        // collapsed until opened
+        expect(root.querySelectorAll('.cdm-position-trade').length).toBe(0);
+
+        (rows[0].querySelector('.cdm-position-toggle') as HTMLElement).click();
+        fixture.detectChanges();
+
+        const trades = Array.from(root.querySelectorAll('.cdm-position-trade')) as HTMLElement[];
+        expect(trades.length).toBe(3);
+        expect(trades.map((row) => row.querySelector('a')!.getAttribute('href')))
+            .toEqual(['/cdm/trade/trd-1', '/cdm/trade/trd-3', '/cdm/trade/trd-100']);
+        const signed = trades.map((row) => Number(text(row.querySelector('.cdm-signed-quantity')).replace(/[,+]/g, '')));
+        expect(signed).toEqual([750, 250, -200]);
+        expect(signed.reduce((sum, value) => sum + value, 0)).toBe(800);
+        expect(text(root.querySelector('.cdm-position-sum'))).toContain('Sum of trade states: 800');
+        expect(text(root.querySelector('.cdm-position-sum'))).toContain('matches the holding');
+        // a missing time ("null") reads as a dash, not as a date
+        expect(text(trades[2].querySelector('.cdm-executed-at'))).toBe('-');
+    });
+
+    it('says an account without CDM trades has none yet (404 pending), not that positions are unavailable', () => {
+        cdm.positions.and.returnValue(of<CdmResult<CdmPositions>>({ status: 'pending', cdmRef: 'cdm:position:22214' }));
+
+        const root = render();
+
+        const section = text(root.querySelector('.cdm-positions'));
+        expect(section).toContain('No CDM trades for this account yet');
+        expect(section).not.toContain('unavailable');
+        expect(root.querySelectorAll('.cdm-position').length).toBe(0);
+    });
+
+    it('says positions are unavailable on a real error', () => {
+        cdm.positions.and.returnValue(throwError(() => new HttpErrorResponse({ status: 503, statusText: 'Service Unavailable' })));
+
+        const root = render();
+
+        const section = text(root.querySelector('.cdm-positions'));
+        expect(section).toContain('CDM positions are unavailable');
+        expect(section).not.toContain('No CDM trades for this account yet');
