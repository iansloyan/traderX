+
+    it('putsTheSelectBackWhenTheSwitchFails', () => {
+        cdm.setServicingParty.and.returnValue(throwError(() => new HttpErrorResponse({ status: 503 })));
+        const root = render();
+        const select = root.querySelector('.cdm-home-servicing-select') as HTMLSelectElement;
+
+        select.value = 'traderx-tky';
+        select.dispatchEvent(new Event('change'));
+        fixture.detectChanges();
+
+        expect(select.value).toBe('traderx-nyc');
+        expect(root.querySelector('.cdm-home-servicing')!.textContent).toContain('Could not change the servicing subsidiary');
+        expect(root.querySelector('.cdm-relationships tr[data-entity="traderx-nyc"]')!.textContent).toContain('Test Account 20');
+    });
+
+    it('listsTradingRelationshipsBySubsidiary', () => {
