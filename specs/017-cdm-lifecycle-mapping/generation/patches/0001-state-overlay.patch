@@ -0,0 +1,140 @@
+import { INestApplication, Module } from '@nestjs/common';
+import { NestFactory } from '@nestjs/core';
+import { AddressInfo } from 'net';
+import { StocksController } from './stocks.controller';
+import { CDM_FETCH, CdmFetch, StocksService } from './stocks.service';
+
+const PROJECTIONS = [
+  { ticker: 'MMM', companyName: '3M', cdmRef: 'cdm:security:MMM' },
+  { ticker: 'IBM', companyName: 'IBM', cdmRef: 'cdm:security:IBM' },
+  { ticker: 'BRK.B', companyName: 'Berkshire Hathaway', cdmRef: 'cdm:security:BRK.B' },
+];
+
+function jsonResponse(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json' },
+  });
+}
+
+function serviceWith(fetchFn: CdmFetch): StocksService {
+  return new StocksService(fetchFn);
+}
+
+async function startApp(fetchFn: CdmFetch): Promise<{ app: INestApplication; baseUrl: string }> {
+  @Module({
+    controllers: [StocksController],
+    providers: [StocksService, { provide: CDM_FETCH, useValue: fetchFn }],
+  })
+  class TestStocksModule {}
+
+  const app = await NestFactory.create(TestStocksModule, { logger: false });
+  await app.listen(0, '127.0.0.1');
+  const { port } = app.getHttpServer().address() as AddressInfo;
+  return { app, baseUrl: `http://127.0.0.1:${port}` };
+}
+
+describe('StocksService', () => {
+  const savedEnv = { ...process.env };
+
+  afterEach(() => {
+    process.env = { ...savedEnv };
+  });
+
+  it('mapsCdmProjection', async () => {
+    const fetchFn = jest.fn<Promise<Response>, Parameters<CdmFetch>>(async () =>
+      jsonResponse(PROJECTIONS.map((p) => ({ ...p, extra: 'ignored' }))),
+    );
+
+    const stocks = await serviceWith(fetchFn).findAll();
+
+    expect(stocks).toEqual(PROJECTIONS);
+    expect(String(fetchFn.mock.calls[0][0])).toBe('http://cdm-service:18120/projections/stocks');
+  });
+
+  it('uses CDM_SERVICE_URL', async () => {
+    process.env.CDM_SERVICE_URL = 'http://localhost:9999/';
+    const fetchFn = jest.fn<Promise<Response>, Parameters<CdmFetch>>(async () =>
+      jsonResponse(PROJECTIONS),
+    );
+
+    await serviceWith(fetchFn).findAll();
+
+    expect(String(fetchFn.mock.calls[0][0])).toBe('http://localhost:9999/projections/stocks');
+  });
+
+  it('finds a ticker by exact match', async () => {
+    const service = serviceWith(async () => jsonResponse(PROJECTIONS));
+
+    expect(await service.findByTicker('BRK.B')).toEqual(PROJECTIONS[2]);
+    expect(await service.findByTicker('ibm')).toBeUndefined();
+    expect(await service.findByTicker('NOPE')).toBeUndefined();
+  });
+
+  it('keeps the supported-ticker and max-ticker filters', async () => {
+    process.env.REFERENCE_DATA_SUPPORTED_TICKERS = 'ibm, brk.b';
+    const filtered = serviceWith(async () => jsonResponse(PROJECTIONS));
+    expect((await filtered.findAll()).map((s) => s.ticker)).toEqual(['IBM', 'BRK.B']);
+    expect(await filtered.findByTicker('MMM')).toBeUndefined();
+
+    delete process.env.REFERENCE_DATA_SUPPORTED_TICKERS;
+    process.env.REFERENCE_DATA_MAX_TICKERS = '2';
+    const capped = serviceWith(async () => jsonResponse(PROJECTIONS));
+    expect((await capped.findAll()).map((s) => s.ticker)).toEqual(['MMM', 'IBM']);
+  });
+
+  it('omits cdmRef when the projection has none', async () => {
+    const service = serviceWith(async () => jsonResponse([{ ticker: 'IBM', companyName: 'IBM' }]));
+
+    expect(await service.findAll()).toEqual([{ ticker: 'IBM', companyName: 'IBM' }]);
+  });
+});
+
+describe('StocksController over HTTP', () => {
+  let app: INestApplication | undefined;
+
