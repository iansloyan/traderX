+    beforeEach(async () => {
+        cdm = jasmine.createSpyObj<CdmService>('CdmService', ['validationSummary', 'rejections', 'orderLineage', 'tradeLineage', 'positions', 'entities', 'setServicingParty']);
+        cdm.entities.and.returnValue(of(['nyc', 'ldn', 'tky'].map((k) => ({
