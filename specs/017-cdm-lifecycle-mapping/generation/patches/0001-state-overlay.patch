@@ -0,0 +1,135 @@
+@use 'cdm-common';
+
+.cdm-layout {
+  display: grid;
+  grid-template-columns: minmax(320px, 5fr) minmax(360px, 7fr);
+  gap: 16px;
+  align-items: start;
+}
+
+@media (max-width: 991px) {
+  .cdm-layout { grid-template-columns: 1fr; }
+}
+
+.cdm-chain { list-style: none; margin: 0; padding: 0; }
+
+.cdm-chain-step {
+  position: relative;
+  padding: 6px 8px 10px 30px;
+  cursor: pointer;
+  border-radius: 6px;
+
+  &::before {
+    content: '';
+    position: absolute;
+    left: 11px;
+    top: 0;
+    bottom: 0;
+    width: 2px;
+    background: #ced4da;
+  }
+
+  &:first-child::before { top: 14px; }
+  &:last-child::before { bottom: calc(100% - 14px); }
+}
+
+// selectable rows: chain steps, rows nested in them, the trade state card
+.cdm-chain-step, .cdm-node-row {
+  &:hover { background: #f1f3f5; }
+}
+
+.cdm-chain-step, .cdm-node-row, .cdm-trade-state-card {
+  &.selected, &.cdm-card-selected { background: #e7f1ff; outline: 1px solid #9ec5fe; }
+}
+
+.cdm-chain-dot {
+  position: absolute;
+  left: 5px;
+  top: 9px;
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  border: 2px solid #fff;
+  box-shadow: 0 0 0 1px #adb5bd;
+  background: #6c757d;
+}
+
+.cdm-step-proposal .cdm-chain-dot { background: #0d6efd; }
+.cdm-step-accepted, .cdm-step-fill-accepted { .cdm-chain-dot { background: #198754; } }
+.cdm-step-cancel .cdm-chain-dot { background: #fd7e14; }
+.cdm-step-rejected .cdm-chain-dot { background: #dc3545; }
+
+// the order proposal holds the tree; only its head selects it
+.cdm-chain-step.cdm-step-proposal {
+  cursor: default;
+  &:hover { background: transparent; }
+  > .cdm-chain-body > .cdm-node-head { cursor: pointer; }
+}
+
+.step-label { font-weight: 600; }
+.cdm-step-meta, .cdm-step-detail { font-size: 0.8rem; color: #495057; }
+.cdm-step-meta { font-variant-numeric: tabular-nums; color: #6c757d; }
+
+.cdm-validation-messages { font-size: 0.78rem; color: #842029; padding-left: 18px; margin: 4px 0 0; }
+
+.cdm-node-row { padding: 3px 6px; border-radius: 4px; cursor: pointer; }
+
+.cdm-fill-steps { margin-left: 14px; border-left: 2px solid #d1e7dd; padding-left: 8px; }
+
+.cdm-fill {
+  border: 1px solid #dee2e6;
+  border-left: 3px solid #198754;
+  border-radius: 6px;
+  padding: 6px 8px;
+  margin-top: 6px;
+
+  &.highlight { border-color: #9ec5fe; border-left-color: #0d6efd; box-shadow: 0 0 0 2px #cfe2ff; }
+  &.cdm-fill-selected { background: #f8fbff; }
+}
+
+.cdm-cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: 12px;
+}
+
+.cdm-card {
+  font-size: 0.86rem;
+
+  .card-header {
+    font-size: 0.78rem;
+    text-transform: uppercase;
+    letter-spacing: 0.05em;
+    color: #495057;
+    padding: 6px 12px;
+  }
+
+  .card-body { padding: 10px 12px; }
+}
+
+.cdm-card-title { font-weight: 600; margin-bottom: 4px; }
+
+.cdm-kv {
+  display: flex;
+  gap: 8px;
+  align-items: baseline;
+  padding: 1px 0;
+
+  .cdm-k { flex: 0 0 110px; }
+  .cdm-v { min-width: 0; overflow-wrap: anywhere; }
+}
+
+.cdm-k { color: #6c757d; font-size: 0.78rem; }
+.cdm-key { font-size: 0.72rem; }
+.cdm-person { padding: 3px 0; border-top: 1px dashed #e9ecef; }
+
+.cdm-json {
+  max-height: 480px;
+  overflow: auto;
+  background: #0f172a;
+  color: #e2e8f0;
+  border-radius: 6px;
+  padding: 10px 12px;
+  font-size: 0.74rem;
