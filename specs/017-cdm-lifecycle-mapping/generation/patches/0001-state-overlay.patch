+/**
+ * account-service against a stub cdm-service (a JDK HTTP server): the REST paths and JSON field
+ * names stay as before, data comes from {@code /projections/...}, and a cdm-service that is
+ * down or not ready gives 503.
+ */
+class AccountServiceCdmTest {
+
+  /** A request the stub received: "METHOD path?query" and its body. */
+  record Received(String request, String body) {
+  }
+
+  private HttpServer cdm;
+  private final List<Received> received = new CopyOnWriteArrayList<>();
+  /** Canned responses by "METHOD path?query": status and body. */
+  private final Map<String, Map.Entry<Integer, String>> responses = new ConcurrentHashMap<>();
+  private final PeopleValidationService people = mock(PeopleValidationService.class);
+
+  @BeforeEach
+  void startStub() throws IOException {
+    cdm = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+    cdm.createContext("/", this::handle);
+    cdm.start();
+  }
+
+  @AfterEach
+  void stopStub() {
+    cdm.stop(0);
+  }
+
+  private void handle(HttpExchange exchange) throws IOException {
+    String query = exchange.getRequestURI().getRawQuery();
+    String key = exchange.getRequestMethod() + " " + exchange.getRequestURI().getPath()
+        + (query == null ? "" : "?" + query);
+    String body = new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8);
+    received.add(new Received(key, body));
+    Map.Entry<Integer, String> response = responses.getOrDefault(key, Map.entry(404, ""));
+    byte[] bytes = response.getValue().getBytes(StandardCharsets.UTF_8);
+    exchange.getResponseHeaders().add("Content-Type", "application/json");
+    exchange.sendResponseHeaders(response.getKey(), bytes.length == 0 ? -1 : bytes.length);
+    if (bytes.length > 0) {
+      exchange.getResponseBody().write(bytes);
+    }
+    exchange.close();
+  }
+
+  private void respond(String request, int status, String body) {
+    responses.put(request, Map.entry(status, body));
+  }
+
+  private MockMvc mvc(String cdmBaseUrl) {
+    CdmServiceClient client = new CdmServiceClient(cdmBaseUrl, 2000);
+    return MockMvcBuilders.standaloneSetup(
+        new AccountController(new AccountService(client)),
+        new AccountUserController(new AccountUserService(client), people)).build();
+  }
+
+  private MockMvc mvc() {
+    return mvc("http://127.0.0.1:" + cdm.getAddress().getPort());
+  }
+
+  @Test
+  void listAccountsReturnsProjectionWithCdmRef() throws Exception {
