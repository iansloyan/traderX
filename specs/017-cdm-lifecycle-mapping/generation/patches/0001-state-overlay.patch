+package finos.traderx.ordermatcher.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import finos.traderx.messaging.Publisher;
+import finos.traderx.ordermatcher.model.OrderRecord;
+import finos.traderx.ordermatcher.model.OrderStatus;
+import finos.traderx.ordermatcher.repository.OrderRepository;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.web.client.RestTemplate;
+
+/** The demo seed orders and {@code order.matcher.seed-statuses} (Ruling R32). */
+class OrderMatcherServiceSeedTest {
+
+    @SuppressWarnings("unchecked")
+    private List<OrderRecord> seeded(String seedStatuses) {
+        OrderRepository repository = mock(OrderRepository.class);
+        when(repository.count()).thenReturn(0L);
+        when(repository.findAllOrderIds()).thenReturn(List.of());
+        new OrderMatcherService(repository, mock(Publisher.class), mock(Publisher.class),
+            mock(RestTemplate.class), true, seedStatuses, "http://price",
+            "http://trade-service/trade/", 1000, 1000);
+        ArgumentCaptor<Iterable<OrderRecord>> saved = ArgumentCaptor.forClass(Iterable.class);
+        verify(repository).saveAll(saved.capture());
+        List<OrderRecord> out = new ArrayList<>();
+        saved.getValue().forEach(out::add);
+        return out;
+    }
+
+    @Test
+    void defaultSeedIsUnchanged() {
+        List<OrderRecord> seed = seeded("");
+
+        assertThat(seed).extracting(OrderRecord::getOrderId).containsExactly(
+            "ord-013-0001", "ord-013-0002", "ord-013-0003", "ord-013-0004", "ord-013-0005",
+            "ord-013-0006", "ord-013-0007");
+        assertThat(seed).extracting(OrderRecord::getStatus).contains(
+            OrderStatus.NEW, OrderStatus.PARTIALLY_FILLED, OrderStatus.FILLED);
+    }
+
+    @Test
+    void seedStatusesPropertyLimitsSeededOrders() {
+        List<OrderRecord> seed = seeded("NEW");
+
+        assertThat(seed).extracting(OrderRecord::getOrderId).containsExactly(
+            "ord-013-0001", "ord-013-0003", "ord-013-0005", "ord-013-0006", "ord-013-0007");
+        assertThat(seed).allSatisfy(order -> {
+            assertThat(order.getStatus()).isEqualTo(OrderStatus.NEW);
+            assertThat(order.getRemainingQuantity()).isEqualTo(order.getQuantity());
+        });
+        assertThat(seeded(" new , filled ")).extracting(OrderRecord::getOrderId)
+            .containsExactly("ord-013-0001", "ord-013-0003", "ord-013-0004", "ord-013-0005",
+                "ord-013-0006", "ord-013-0007");
+    }
+
+    @Test
+    void unknownSeedStatusIsRejected() {
+        assertThatThrownBy(() -> OrderMatcherService.parseSeedStatuses("NEW,OPEN"))
+            .isInstanceOf(IllegalArgumentException.class)
+            .hasMessageContaining("OPEN");
+    }
+}
