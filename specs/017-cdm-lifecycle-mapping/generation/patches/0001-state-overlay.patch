+import { NO_ERRORS_SCHEMA } from '@angular/core';
+import { TestBed } from '@angular/core/testing';
+import { of } from 'rxjs';
+import { OrderAdminService } from '../service/order-admin.service';
+import { PriceSnapshotService } from '../service/price-snapshot.service';
+import { TradeFeedService } from '../service/trade-feed.service';
+import { OrderAdminComponent } from './order-admin.component';
+
+describe('OrderAdminComponent grid layout', () => {
+    let component: OrderAdminComponent;
+
+    beforeEach(() => {
+        component = new OrderAdminComponent({} as any, {} as any, {} as any);
+    });
+
+    it('adminColumnsHaveMinWidthsAndFitOrScroll: every column has a minWidth, ids and actions are protected', () => {
+        const cols = component.columnDefs;
+        cols.forEach((c) => expect(c.minWidth).withContext(c.headerName!).toBeGreaterThan(0));
+        const byName = (n: string) => cols.find((c) => c.headerName === n)!;
+        expect(byName('ORDER ID').minWidth).toBeGreaterThanOrEqual(120);
+        // Header text (13px bold Alpine) + ~40px padding/icon must fit at the column's minimum:
+        // ACCOUNT and SECURITY clipped to "ACCOU…"/"SECURI…" at 100.
+        expect(byName('ACCOUNT').minWidth).toBeGreaterThanOrEqual(120);
+        expect(byName('SECURITY').minWidth).toBeGreaterThanOrEqual(120);
+        ['STRIKE', 'MARKET', 'DELTA', 'QTY', 'SIDE', 'CANCEL'].forEach((n) =>
+            expect(byName(n).minWidth).withContext(n).toBeGreaterThanOrEqual(80));
+        ['CANCEL', 'FORCE FILL'].forEach((n) => {
+            expect(byName(n).minWidth).withContext(n).toBeGreaterThanOrEqual(110);
+            expect(byName(n).pinned).withContext(n).toBe('right');
+        });
+        cols.forEach((c) => expect(c.headerTooltip).withContext(c.headerName!).toBe(c.headerName));
+        expect(component.defaultColDef.resizable).toBeTrue();
+    });
+
+    it('fitColumns always calls sizeColumnsToFit (minWidth + horizontal scroll prevent clipping) and tolerates no grid', () => {
+        expect(() => component.fitColumns()).not.toThrow();
+        const api = { sizeColumnsToFit: jasmine.createSpy('fit') };
+        component.gridApi = api as any;
+        component.fitColumns();
+        expect(api.sizeColumnsToFit).toHaveBeenCalledTimes(1);
+    });
+});
+
+describe('OrderAdminComponent template (rendered)', () => {
+    it('binds defaultColDef and re-fits on gridSizeChanged', () => {
+        TestBed.configureTestingModule({
+            declarations: [OrderAdminComponent],
+            schemas: [NO_ERRORS_SCHEMA],
+            providers: [
+                { provide: OrderAdminService, useValue: { getOpenOrders: () => of([]), subscribe: () => () => {} } },
+                { provide: TradeFeedService, useValue: { subscribe: () => () => {} } },
+                { provide: PriceSnapshotService, useValue: {} }
+            ]
+        });
+        const fixture = TestBed.createComponent(OrderAdminComponent);
+        const component = fixture.componentInstance;
+        const fit = spyOn(component, 'fitColumns');
+        fixture.detectChanges();
+        const grid = fixture.nativeElement.querySelector('ag-grid-angular');
+        expect(grid.defaultColDef).toBe(component.defaultColDef);
+        grid.dispatchEvent(new CustomEvent('gridSizeChanged'));
+        expect(fit).toHaveBeenCalled();
+    });
+});
