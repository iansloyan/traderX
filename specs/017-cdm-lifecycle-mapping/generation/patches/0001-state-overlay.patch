@@ -0,0 +1,108 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace PeopleService.WebApi.Directory;
+
+/// <summary>
+/// The directory as a projection of the CDM person master in cdm-service
+/// (<c>GET /projections/people…</c>). cdm-service serves only persons with full directory
+/// details; identifier-only persons are not found (Ruling R20). Any failure to get an answer
+/// (connection refused, timeout, cdm-service not ready, 5xx, unreadable body) is a
+/// <see cref="CdmServiceUnavailableException"/>.
+/// </summary>
+public sealed class CdmDirectoryService(HttpClient http, ILogger<CdmDirectoryService> logger) : IDirectoryService
+{
+    public const string HttpClientName = "cdm-service";
+    public const string DefaultBaseUrl = "http://cdm-service:18120";
+    public const int DefaultTimeoutMs = 5000;
+
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+
+    /// <summary>One person as cdm-service projects it.</summary>
+    private sealed record PersonProjection(
+        string? LogonId, string? FullName, string? Email, string? EmployeeId,
+        string? Department, string? PhotoUrl, string? CdmRef);
+
+    public async Task<Person?> GetPersonAsync(string? logonId, string? employeeId)
+    {
+        if (!string.IsNullOrWhiteSpace(logonId))
+        {
+            var person = await GetAsync<PersonProjection>(
+                $"projections/people/{Uri.EscapeDataString(logonId)}", notFoundIsEmpty: true);
+            return person is null ? null : ToPerson(person);
+        }
+
+        var matches = await GetAsync<List<PersonProjection>>(
+            $"projections/people?employeeId={Uri.EscapeDataString(employeeId ?? "")}", notFoundIsEmpty: false);
+        return matches?.Select(ToPerson).FirstOrDefault();
+    }
+
+    public async Task<List<Person>> GetMatchingPeopleAsync(string searchText, int take)
+    {
+        var matches = await GetAsync<List<PersonProjection>>(
+            $"projections/people?search={Uri.EscapeDataString(searchText)}", notFoundIsEmpty: false);
+        return (matches ?? []).Select(ToPerson).Take(take).ToList();
+    }
+
+    public async Task<bool> ValidatePersonAsync(string? logonId, string? employeeId)
+    {
+        return await GetPersonAsync(logonId, employeeId) is not null;
+    }
+
+    private static Person ToPerson(PersonProjection p) => new()
+    {
+        LogonId = p.LogonId ?? "",
+        FullName = p.FullName ?? "",
+        Email = p.Email ?? "",
+        EmployeeId = p.EmployeeId ?? "",
+        Department = p.Department ?? "",
+        PhotoUrl = p.PhotoUrl ?? "",
+        CdmRef = p.CdmRef,
+
+    };
+
+    /// <summary>
+    /// The body of a 2xx answer; null for 404 (and for 400, which cdm-service's web server gives
+    /// for a logon id it cannot route, e.g. one with an encoded slash) when
+    /// <paramref name="notFoundIsEmpty"/>.
+    /// </summary>
+    private async Task<T?> GetAsync<T>(string relativeUri, bool notFoundIsEmpty) where T : class
+    {
+        HttpResponseMessage response;
+        try
+        {
+            response = await http.GetAsync(relativeUri);
+        }
+        catch (Exception e) when (e is HttpRequestException or TaskCanceledException)
+        {
+            logger.LogWarning(e, "cdm-service request {Uri} failed", relativeUri);
+            throw new CdmServiceUnavailableException("CDM service unavailable", e);
+        }
+
+        using (response)
+        {
+            if (notFoundIsEmpty && response.StatusCode is HttpStatusCode.NotFound or HttpStatusCode.BadRequest)
+            {
+                return null;
+            }
+
+            if (!response.IsSuccessStatusCode)
+            {
+                logger.LogWarning("cdm-service request {Uri} answered {Status}", relativeUri, (int)response.StatusCode);
+                throw new CdmServiceUnavailableException("CDM service unavailable");
+            }
+
+            try
+            {
+                return await response.Content.ReadFromJsonAsync<T>(JsonOptions)
+                    ?? throw new JsonException("empty body");
+            }
+            catch (Exception e) when (e is JsonException or NotSupportedException or HttpRequestException)
+            {
+                logger.LogWarning(e, "cdm-service request {Uri} returned an unreadable body", relativeUri);
+                throw new CdmServiceUnavailableException("CDM service unavailable", e);
+            }
+        }
+    }
+}
