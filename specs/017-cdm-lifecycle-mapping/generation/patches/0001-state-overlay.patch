+        "[{\"id\":22214,\"displayName\":\"Test Account 20\",\"cdmRef\":\"cdm:party:22214\","
+            + "\"servicingPartyRef\":\"cdm:party:traderx-nyc\",\"servicingPartyName\":\"TraderX NYC\"},"
+            + "{\"id\":52355,\"displayName\":\"Big Corporate Fund\",\"cdmRef\":\"cdm:party:52355\"}]");
+
+    // The servicing subsidiary passes through; an account without one keeps the 009 shape plus cdmRef.
+    mvc().perform(get("/account/"))
+        .andExpect(status().isOk())
+        .andExpect(content().json(
+            "[{\"id\":22214,\"displayName\":\"Test Account 20\",\"cdmRef\":\"cdm:party:22214\","
+                + "\"servicingPartyRef\":\"cdm:party:traderx-nyc\",\"servicingPartyName\":\"TraderX NYC\"},"
+                + "{\"id\":52355,\"displayName\":\"Big Corporate Fund\","
+                + "\"cdmRef\":\"cdm:party:52355\"}]", JsonCompareMode.STRICT));
+  }
+
+  @Test
+  void getAccountByIdKeepsThe404() throws Exception {
+    respond("GET /projections/accounts/22214", 200,
+        "{\"id\":22214,\"displayName\":\"Test Account 20\",\"cdmRef\":\"cdm:party:22214\"}");
+
+    mvc().perform(get("/account/22214"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.id").value(22214))
+        .andExpect(jsonPath("$.displayName").value("Test Account 20"))
+        .andExpect(jsonPath("$.cdmRef").value("cdm:party:22214"));
+    mvc().perform(get("/account/1"))
+        .andExpect(status().isNotFound())
+        .andExpect(content().string("Account with id 1 not found"));
+  }
+
+  @Test
+  void createAccountGoesThroughCdmService() throws Exception {
+    respond("POST /projections/accounts", 200,
+        "{\"id\":65000,\"displayName\":\"New Fund\",\"cdmRef\":\"cdm:party:65000\"}");
+
+    mvc().perform(post("/account/").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"displayName\":\"New Fund\"}"))
+        .andExpect(status().isOk())
+        .andExpect(content().json(
+            "{\"id\":65000,\"displayName\":\"New Fund\",\"cdmRef\":\"cdm:party:65000\"}",
+            JsonCompareMode.STRICT));
+
+    assertThat(received).hasSize(1);
+    assertThat(received.get(0).request()).isEqualTo("POST /projections/accounts");
+    assertThat(received.get(0).body()).contains("\"displayName\":\"New Fund\"");
+  }
+
+  @Test
+  void updateWithAnIdUpsertsThatAccountInCdm() throws Exception {
+    respond("PUT /projections/accounts/22214", 200,
+        "{\"id\":22214,\"displayName\":\"Renamed\",\"cdmRef\":\"cdm:party:22214\"}");
+
+    mvc().perform(put("/account/").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"id\":22214,\"displayName\":\"Renamed\"}"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.displayName").value("Renamed"));
+
+    assertThat(received).extracting(Received::request).containsExactly("PUT /projections/accounts/22214");
+  }
+
+  @Test
+  void accountUsersComeFromCdmWithTheOldFirstUserLookup() throws Exception {
+    String users = "[{\"accountId\":22214,\"username\":\"user01\",\"cdmRef\":\"cdm:person:user01\"},"
+        + "{\"accountId\":22214,\"username\":\"user03\",\"cdmRef\":\"cdm:person:user03\"}]";
+    respond("GET /projections/accountusers", 200, users);
+    respond("GET /projections/accountusers?accountId=22214", 200, users);
+    respond("GET /projections/accountusers?accountId=1", 200, "[]");
+
+    mvc().perform(get("/accountuser/"))
+        .andExpect(status().isOk())
+        .andExpect(content().json(users, JsonCompareMode.STRICT));
+    mvc().perform(get("/accountuser/22214"))
+        .andExpect(status().isOk())
+        .andExpect(content().json(
+            "{\"accountId\":22214,\"username\":\"user01\",\"cdmRef\":\"cdm:person:user01\"}",
+            JsonCompareMode.STRICT));
+    mvc().perform(get("/accountuser/1"))
+        .andExpect(status().isNotFound())
+        .andExpect(content().string("AccountUser with id 1 not found"));
+  }
+
+  @Test
+  void addAccountUserValidatesThePersonThenWritesToCdm() throws Exception {
+    when(people.validatePerson("user04")).thenReturn(true);
+    respond("POST /projections/accountusers", 200,
+        "{\"accountId\":22214,\"username\":\"user04\",\"cdmRef\":\"cdm:person:user04\"}");
+
+    mvc().perform(post("/accountuser/").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"accountId\":22214,\"username\":\"user04\"}"))
