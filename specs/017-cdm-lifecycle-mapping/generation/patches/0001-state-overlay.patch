+    down.perform(put("/account/").contentType(MediaType.APPLICATION_JSON)
+        .content("{\"id\":22214,\"displayName\":\"x\"}")).andExpect(status().isServiceUnavailable());
+    down.perform(get("/accountuser/")).andExpect(status().isServiceUnavailable());
+    down.perform(get("/accountuser/22214")).andExpect(status().isServiceUnavailable());
+    down.perform(post("/accountuser/").contentType(MediaType.APPLICATION_JSON)
