+name: traderx-state-017
+
+services:
+  database:
+    image: postgres:16-alpine
+    environment:
+      POSTGRES_DB: "traderx"
+      POSTGRES_USER: "traderx"
+      POSTGRES_PASSWORD: "traderx"
+    ports:
+      - "18083:5432"
+    healthcheck:
+      test: [ "CMD-SHELL", "pg_isready -U traderx -d traderx" ]
+      interval: 5s
+      timeout: 5s
+      retries: 20
