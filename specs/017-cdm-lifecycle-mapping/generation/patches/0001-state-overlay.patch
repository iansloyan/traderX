+
+    it('showsTheSelectedAccountsServicingSubsidiaryAndSwitchesIt', () => {
+        const root = render();
+        const select = root.querySelector('.cdm-home-servicing-select') as HTMLSelectElement;
+        expect(select.options[select.selectedIndex].text.trim()).toBe('TraderX NYC');
+
+        select.value = 'traderx-tky';
