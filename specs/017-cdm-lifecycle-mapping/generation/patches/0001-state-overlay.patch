index 0000000..f53bfdc
--- /dev/null
+++ b/account-service/src/main/java/finos/traderx/accountservice/exceptions/CdmServiceClientErrorException.java
@@ -0,0 +1,20 @@
+package finos.traderx.accountservice.exceptions;
+
+/**
+ * cdm-service rejected the request as the caller's fault (for example 400 for a display name
+ * over 50 characters, or 409 when no free account id exists). account-service answers with the
+ * same status and message.
+ */
+public class CdmServiceClientErrorException extends RuntimeException {
+
+  private final int status;
+
+  public CdmServiceClientErrorException(int status, String message, Throwable cause) {
+    super(message, cause);
+    this.status = status;
+  }
+
+  public int getStatus() {
+    return status;
+  }
+}
