+        filledSoFar,
+        executionType: 'OnVenue',
+        executionTypeMeaning: FILL_MEANING,
+        proposed: step('fill-proposed', `f${fillNumber}p`, null),
+        accepted: step('fill-accepted', `f${fillNumber}a`, `f${fillNumber}p`, {
+            object: { businessEvent: { eventDate: '2026-10-29' }, meta: { globalKey: `f${fillNumber}a` } }
+        }),
+        tradeState: {
