+-- State 017: versioned store of FINOS CDM objects owned by cdm-service (one row per version;
+-- id is the write order, global_key = SHA-256 of canonical JSON, not unique). previous_global_key
+-- links versions within one cdm_ref; produced_by_ref/produced_by_global_key record the object
+-- under another ref that produced this one (a trade's TradeState: its accepted workflow step).
+CREATE TABLE cdm_documents (
+  id BIGSERIAL PRIMARY KEY,
+  global_key VARCHAR(128) NOT NULL,
+  cdm_ref VARCHAR(160) NOT NULL,
+  cdm_type VARCHAR(128) NOT NULL,
+  payload TEXT NOT NULL,
+  previous_global_key VARCHAR(128) NULL,
+  validation_status VARCHAR(16) NOT NULL,
+  validation_messages TEXT NULL,
+  created_at TIMESTAMP NOT NULL,
+  produced_by_ref VARCHAR(160) NULL,
+  produced_by_global_key VARCHAR(128) NULL
+);
+CREATE INDEX idx_cdm_documents_global_key ON cdm_documents(global_key);
+CREATE INDEX idx_cdm_documents_ref ON cdm_documents(cdm_ref);
+
+-- State 017: CDM lifecycle adapter (cdm-service). Booked trades parked until their order's
+-- approved proposal is stored, CANCELED events waiting for their order's last fills, and
+-- lifecycle failures (events not fully turned into stored CDM) for the CDM view.
+CREATE TABLE cdm_pending_trades (
+  trade_id VARCHAR(100) PRIMARY KEY,
+  order_id VARCHAR(100) NOT NULL,
+  payload TEXT NOT NULL,
+  received_at TIMESTAMP NOT NULL,
+  reported_at TIMESTAMP NULL
+);
+CREATE INDEX idx_cdm_pending_trades_order ON cdm_pending_trades(order_id);
+CREATE TABLE cdm_pending_cancels (
+  order_id VARCHAR(100) PRIMARY KEY,
+  payload TEXT NOT NULL,
+  received_at TIMESTAMP NOT NULL,
+  reported_at TIMESTAMP NULL
+);
+CREATE TABLE cdm_lifecycle_failures (
+  id BIGSERIAL PRIMARY KEY,
+  cdm_ref VARCHAR(160) NULL,
+  stage VARCHAR(32) NOT NULL,
+  message TEXT NOT NULL,
+  payload TEXT NULL,
+  failed_at TIMESTAMP NOT NULL
+);
+CREATE INDEX idx_cdm_lifecycle_failures_ref ON cdm_lifecycle_failures(cdm_ref);
+
