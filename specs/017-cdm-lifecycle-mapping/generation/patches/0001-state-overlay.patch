+<div class="cdm-view-container p-4">
+  <div class="d-flex flex-wrap align-items-baseline gap-3 mb-1">
+    <a class="small" routerLink="/cdm">&larr; CDM overview</a>
+    <h4 class="mb-0">
+      CDM lineage
+      <span class="text-muted">· {{ kind === 'trade' ? 'Trade' : 'Order' }}</span>
+      <code class="cdm-id ms-1">{{ id }}</code>
+    </h4>
+    <code class="cdm-ref" title="TraderX cdmRef">{{ cdmRef }}</code>
+  </div>
+  <div class="text-muted small mb-3" *ngIf="kind === 'trade'; else orderIntro">
+    The trade's FINOS CDM TradeState, then the workflow that produced it: a fill of an order, or a direct trade's
+    own proposed and accepted steps. Every version is validated (cardinality, types, data rules;
+    <code>Qualify_Execution</code> for executions).
+  </div>
+  <ng-template #orderIntro>
+    <div class="text-muted small mb-3">
+      The order is a FINOS CDM proposal answered by the venue; each fill is its own proposed and accepted workflow
+      whose execution produced a trade state, so fills are drawn inside the order, not after it. Every version is
+      validated (cardinality, types, data rules; <code>Qualify_Execution</code> for executions).
+    </div>
+  </ng-template>
+
+  <!-- pending: 404 {"status":"pending"} -->
+  <div *ngIf="state === 'pending' || state === 'pending-timeout'" class="cdm-pending alert alert-info d-flex align-items-center gap-3">
+    <div *ngIf="state === 'pending'" class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
+    <div>
+      <div><strong>CDM record is being built…</strong></div>
+      <div class="small">
+        cdm-service has no CDM object for <code>{{ pendingRef || cdmRef }}</code> yet (the lifecycle adapter has not caught up).
+        <span *ngIf="state === 'pending'">Retrying automatically (attempt {{ pendingAttempts }}).</span>
+        <span *ngIf="state === 'pending-timeout'">Still not available after {{ pendingAttempts - 1 }} retries.</span>
+      </div>
+    </div>
+    <button *ngIf="state === 'pending-timeout'" type="button" class="btn btn-sm btn-outline-primary ms-auto" (click)="retryNow()">Retry</button>
+  </div>
+
+  <div *ngIf="state === 'loading'" class="text-muted">Loading CDM lineage…</div>
+  <div *ngIf="state === 'error'" class="alert alert-danger">{{ errorMessage }}</div>
+
+  <ng-container *ngIf="state === 'ready'">
+    <!-- quantities -->
+    <div class="row g-2 mb-3 cdm-quantities" *ngIf="quantities as q">
+      <div class="col-6 col-md">
+        <div class="cdm-stat"><span class="cdm-stat-label">Status</span><strong class="cdm-status">{{ q.status }}</strong></div>
+      </div>
+      <div class="col-6 col-md" *ngIf="q.instruction !== null">
+        <div class="cdm-stat"><span class="cdm-stat-label">Instructed</span><strong class="cdm-instructed">{{ formatQuantity(q.instruction) }}</strong></div>
+      </div>
+      <div class="col-6 col-md">
+        <div class="cdm-stat"><span class="cdm-stat-label">Executed</span><strong class="cdm-executed">{{ formatQuantity(q.executed) }}</strong></div>
+      </div>
+      <div class="col-6 col-md" *ngIf="q.remaining !== null">
+        <div class="cdm-stat"><span class="cdm-stat-label">Remaining</span><strong class="cdm-remaining">{{ formatQuantity(q.remaining) }}</strong></div>
+      </div>
+      <div class="col-6 col-md" *ngIf="q.canceled !== null">
+        <div class="cdm-stat"><span class="cdm-stat-label">Canceled</span><strong class="cdm-canceled">{{ formatQuantity(q.canceled) }}</strong></div>
+      </div>
+    </div>
+    <div *ngIf="order?.quantityWarning" class="alert alert-warning py-2 px-3">{{ order?.quantityWarning }}</div>
+
+    <div class="cdm-layout">
+      <!-- order: proposal tree -->
+      <section class="cdm-chain-panel" *ngIf="tree as t">
+        <h6 class="cdm-section-title">Lineage</h6>
+        <ol class="cdm-chain">
+          <li class="cdm-chain-step cdm-step-proposal"
+              [class.selected]="!!selected && t.versions.includes(selected)"
+              [class.cdm-step-rejected]="t.approval.approved === false">
+            <span class="cdm-chain-dot" aria-hidden="true"></span>
+            <div class="cdm-chain-body">
+              <div class="cdm-node-head d-flex flex-wrap align-items-center gap-2" (click)="select(t.proposal)">
+                <span class="step-label">Order proposal</span>
+                <span [ngClass]="badgeClass(t.validation?.status)" [title]="validationTitle(t.validation)">{{ t.validation?.status || 'NOT VALIDATED' }}</span>
+                <span class="badge cdm-approval"
+                      [ngClass]="t.approval.approved === true ? 'cdm-approval-approved bg-primary-subtle text-primary-emphasis'
+                        : t.approval.approved === false ? 'cdm-approval-rejected bg-danger-subtle text-danger-emphasis'
+                        : 'cdm-approval-pending bg-secondary-subtle text-secondary-emphasis'"
+                      title="The venue's answer to the proposal (CDM WorkflowStep.approval)">{{ t.approval.text }}</span>
+              </div>
+              <div class="cdm-step-detail cdm-proposal-execution-type" *ngIf="t.executionType">
+                <span class="cdm-k me-1">Execution type</span>
+                <ng-container *ngTemplateOutlet="executionType; context: { $implicit: t.executionType, meaning: t.executionTypeMeaning }"></ng-container>
+              </div>
+
+              <!-- the proposal's own versions -->
+              <ul class="cdm-versions list-unstyled mt-1 mb-0">
+                <li *ngFor="let version of t.versions; trackBy: trackNode" class="cdm-version cdm-node-row"
+                    [class.selected]="version === selected" (click)="select(version, $event)">
+                  <ng-container *ngTemplateOutlet="nodeRow; context: { $implicit: version }"></ng-container>
+                </li>
+              </ul>
+
+              <!-- fills: each its own workflow under the order -->
+              <div class="cdm-fills-title cdm-section-title mt-2 mb-0" *ngIf="t.fills.length">Fills ({{ t.fills.length }})</div>
+              <ol class="cdm-fills list-unstyled mb-0" *ngIf="t.fills.length">
+                <li *ngFor="let fill of t.fills; trackBy: trackFill" class="cdm-fill"
+                    [class.highlight]="fill.highlight" [class.cdm-fill-selected]="fillSelected(fill)">
+                  <div class="cdm-fill-head d-flex flex-wrap align-items-center gap-2">
+                    <span class="cdm-fill-title fw-semibold">{{ fill.title }}</span>
+                    <span [ngClass]="badgeClass(fill.validation?.status)" class="cdm-validation"
+                          [title]="validationTitle(fill.validation)">{{ fill.validation?.status || 'NOT VALIDATED' }}</span>
+                    <span *ngIf="fill.highlight" class="badge text-bg-primary">this trade</span>
+                  </div>
+                  <div class="cdm-step-detail" *ngIf="fill.fill.executionType">
+                    <span class="cdm-k me-1">Execution type</span>
+                    <ng-container *ngTemplateOutlet="executionType; context: { $implicit: fill.fill.executionType, meaning: fill.fill.executionTypeMeaning }"></ng-container>
+                  </div>
+                  <div class="cdm-fill-trade-state cdm-node-row d-flex flex-wrap align-items-center gap-2 small" *ngIf="fill.tradeState as ts; else noTradeState"
+                       [class.selected]="ts === selected" (click)="select(ts, $event)">
+                    <span class="cdm-k">Trade state</span>
+                    <a [routerLink]="['/cdm', 'trade', fill.fill.tradeId]" (click)="$event.stopPropagation()" title="Open the trade page"><code>{{ fill.fill.tradeId }}</code></a>
+                    <span *ngIf="fill.fill.tradeState?.positionState" class="text-muted">({{ fill.fill.tradeState?.positionState }})</span>
+                    <span [ngClass]="badgeClass(ts.validation?.status)" class="cdm-validation" [title]="validationTitle(ts.validation)"
+                          (click)="toggleMessages(ts, $event)">{{ ts.validation?.status || 'NOT VALIDATED' }}</span>
+                    <ul *ngIf="expandedMessages.has(ts.id) && ts.validation?.messages?.length" class="cdm-validation-messages">
+                      <li *ngFor="let message of ts.validation?.messages">{{ message }}</li>
+                    </ul>
+                  </div>
+                  <ng-template #noTradeState>
+                    <div class="cdm-fill-trade-state small">
+                      <span class="cdm-k">Trade state</span> <code>{{ fill.fill.tradeId }}</code>
+                      <span class="cdm-badge cdm-badge-pending ms-1">not stored yet</span>
+                    </div>
+                  </ng-template>
+                  <button type="button" class="btn btn-link btn-sm p-0 small cdm-fill-toggle" (click)="toggleFill(fill, $event)"
+                          [attr.aria-expanded]="isFillExpanded(fill)">
+                    {{ isFillExpanded(fill) ? 'Hide' : 'Show' }} proposed and accepted steps
