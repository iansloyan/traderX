+            failures: { total: 0, recent: [] }, pending: { trades: 0, cancels: 0 }
+        }));
+        cdm.rejections.and.returnValue(of({ count: 0, rejections: [] }));
+        cdm.positions.and.returnValue(of<CdmResult<CdmPositions>>({ status: 'ok', data: positions() }));
+        const accountService = jasmine.createSpyObj<AccountService>('AccountService', ['getAccounts']);
+        accountService.getAccounts.and.returnValue(of([
+            { id: 22214, displayName: 'Test Account 20', servicingPartyRef: 'cdm:party:traderx-nyc', servicingPartyName: 'TraderX NYC' },
+            { id: 62654, displayName: 'Hedge Fund TXY1', servicingPartyRef: 'cdm:party:traderx-ldn', servicingPartyName: 'TraderX LDN' }
+        ]));
+        const orderAdmin = jasmine.createSpyObj<OrderAdminService>('OrderAdminService', ['getOrders']);
+        orderAdmin.getOrders.and.returnValue(of([]));
