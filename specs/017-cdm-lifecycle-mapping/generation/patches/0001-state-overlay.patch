+        const rows = Array.from(root.querySelectorAll('.cdm-relationships tbody tr')) as HTMLElement[];
+        expect(rows.map((row) => text(row.querySelector('td')))).toEqual(['TraderX NYC', 'TraderX LDN', 'TraderX TKY']);
+        expect(text(rows[0])).toContain('Test Account 20 (22214)');
+        expect(text(rows[1])).toContain('Hedge Fund TXY1 (62654)');
