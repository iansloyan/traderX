+package finos.traderx.accountservice.exceptions;
+
+/** cdm-service is down, not ready (still seeding) or failed; answered as HTTP 503. */
+public class CdmServiceUnavailableException extends RuntimeException {
+
+  public CdmServiceUnavailableException(String message, Throwable cause) {
+    super(message, cause);
+  }
+}
