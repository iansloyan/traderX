+        .andExpect(jsonPath("$.cdmRef").value("cdm:person:user04"));
+
+    assertThat(received).extracting(Received::request)
+        .containsExactly("POST /projections/accountusers");
+    assertThat(received.get(0).body()).contains("\"accountId\":22214", "\"username\":\"user04\"");
+  }
+
+  @Test
+  void addAccountUserToAnUnknownAccountIs404WithTheOldMessage() throws Exception {
+    when(people.validatePerson("user04")).thenReturn(true);
+    // The stub answers 404 for POST /projections/accountusers (unknown account).
+
+    mvc().perform(post("/accountuser/").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"accountId\":99999,\"username\":\"user04\"}"))
