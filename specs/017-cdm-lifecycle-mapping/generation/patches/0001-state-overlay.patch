+<div class="cdm-view-container p-4">
+  <div class="d-flex flex-wrap align-items-center gap-3 mb-1">
+    <h4 class="mb-0">CDM lifecycle</h4>
+    <app-ngx-dropdown
+      name="cdmAccount"
+      [items]="accounts"
+      itemKey="displayName"
+      [selectedItem]="account"
+      placeholder="Select Account"
+      (selectedItemChange)="onAccountChange($event)">
+    </app-ngx-dropdown>
+    <code class="cdm-ref" *ngIf="account">cdm:party:{{ account.id }}</code>
+    <div class="d-flex align-items-center gap-2 cdm-home-servicing" *ngIf="account">
+      <label class="small text-muted mb-0" for="cdmHomeServicing"
+             title="TraderX subsidiary that services this client and trades with it as dealer (Party1): CDM Account.servicingParty">Serviced by</label>
+      <select id="cdmHomeServicing" class="form-select form-select-sm cdm-home-servicing-select"
+              [disabled]="servicingSaving || !entities.length"
+              (change)="changeServicingEntity($any($event.target).value, $any($event.target))">
+        <option *ngIf="!servicingKey(account)" value="" selected>—</option>
+        <option *ngFor="let entity of entities" [value]="entity.externalKey"
+                [selected]="entity.externalKey === servicingKey(account)">{{ entity.name }}</option>
+      </select>
+      <small class="text-muted">applies to later orders and trades</small>
+      <small class="text-danger" *ngIf="servicingError">{{ servicingError }}</small>
+    </div>
+  </div>
+  <div class="text-muted small mb-3">
+    FINOS CDM view of TraderX orders and trades held by cdm-service. Open a row to see its workflow lineage,
+    parties, security and raw CDM JSON.
+  </div>
+
+  <!-- validation summary strip -->
+  <div class="row g-2 mb-3 cdm-summary" *ngIf="summary as s">
+    <div class="col-6 col-md">
+      <div class="cdm-stat"><span class="cdm-stat-label">CDM objects</span><strong>{{ formatQuantity(s.objects.total) }}</strong></div>
+    </div>
+    <div class="col-6 col-md">
+      <div class="cdm-stat"><span class="cdm-stat-label">Valid</span><strong class="text-success">{{ formatQuantity(countOf('VALID')) }}</strong></div>
+    </div>
+    <div class="col-6 col-md">
+      <div class="cdm-stat"><span class="cdm-stat-label">Invalid</span><strong [class.text-danger]="countOf('INVALID') > 0">{{ formatQuantity(countOf('INVALID')) }}</strong></div>
+    </div>
+    <div class="col-6 col-md">
+      <div class="cdm-stat"><span class="cdm-stat-label">Not qualified</span><strong [class.text-warning]="countOf('NOT_QUALIFIED') > 0">{{ formatQuantity(countOf('NOT_QUALIFIED')) }}</strong></div>
+    </div>
+    <div class="col-6 col-md">
+      <div class="cdm-stat"><span class="cdm-stat-label">Lifecycle failures</span><strong [class.text-danger]="s.failures.total > 0">{{ formatQuantity(s.failures.total) }}</strong></div>
+    </div>
+    <div class="col-6 col-md">
+      <div class="cdm-stat"><span class="cdm-stat-label">Parked trades / cancels</span><strong>{{ s.pending.trades }} / {{ s.pending.cancels }}</strong></div>
+    </div>
+    <div class="col-6 col-md" *ngIf="s.backfill">
+      <div class="cdm-stat"><span class="cdm-stat-label">Startup backfill</span><strong>{{ s.backfill.complete ? 'complete' : 'running' }}</strong></div>
+    </div>
+  </div>
+  <div *ngIf="summaryError" class="alert alert-warning py-2 px-3">cdm-service validation summary is unavailable.</div>
+
+  <div class="cdm-home-grid">
+    <section>
+      <h6 class="cdm-section-title">Recent orders</h6>
+      <table class="table table-sm table-hover cdm-table cdm-orders">
+        <thead>
+          <tr><th>Order</th><th>Security</th><th>Side</th><th class="text-end">Qty</th><th class="text-end">Filled</th><th>Status</th><th>CDM</th></tr>
+        </thead>
+        <tbody>
+          <tr *ngFor="let order of orders">
+            <td><a [routerLink]="cdmViewPath('order', order.orderId, order.cdmRef)"><code>{{ order.orderId }}</code></a></td>
+            <td>{{ order.security }}</td>
+            <td>{{ order.side }}</td>
+            <td class="text-end">{{ formatQuantity(order.quantity) }}</td>
+            <td class="text-end">{{ formatQuantity(order.filledQuantity) }}</td>
+            <td>{{ order.status }}</td>
+            <td>
+              <span *ngIf="orderBadges[order.orderId] as badge; else badgeLoading" [ngClass]="badgeClass(badge.status)" [title]="badge.title">{{ badge.status }}</span>
+              <small class="text-muted ms-1" *ngIf="orderBadges[order.orderId]?.lineageStatus">{{ orderBadges[order.orderId]?.lineageStatus }}</small>
+            </td>
+          </tr>
+          <tr *ngIf="!loadingRows && orders.length === 0"><td colspan="7" class="text-muted">No orders for this account.</td></tr>
+        </tbody>
+      </table>
+    </section>
+
+    <section>
+      <h6 class="cdm-section-title">Recent trades</h6>
+      <table class="table table-sm table-hover cdm-table cdm-trades">
+        <thead>
+          <tr><th>Trade</th><th>Security</th><th>Side</th><th class="text-end">Qty</th><th class="text-end">Price</th><th>CDM</th></tr>
+        </thead>
+        <tbody>
+          <tr *ngFor="let trade of trades">
+            <td><a [routerLink]="cdmViewPath('trade', trade.id)"><code>{{ trade.id | slice:0:8 }}…</code></a></td>
+            <td>{{ trade.security }}</td>
+            <td>{{ trade.side }}</td>
+            <td class="text-end">{{ formatQuantity(trade.quantity) }}</td>
+            <td class="text-end">{{ formatPrice(trade.price) }}</td>
+            <td>
+              <span *ngIf="tradeBadges[trade.id] as badge; else badgeLoading" [ngClass]="badgeClass(badge.status)" [title]="badge.title">{{ badge.status }}</span>
+              <small class="text-muted ms-1" *ngIf="tradeBadges[trade.id]?.lineageStatus">{{ tradeBadges[trade.id]?.lineageStatus }}</small>
+            </td>
+          </tr>
+          <tr *ngIf="trades.length === 0"><td colspan="6" class="text-muted">No trades for this account.</td></tr>
+        </tbody>
+      </table>
+    </section>
+  </div>
+
+  <section class="mt-3 cdm-positions">
+    <h6 class="cdm-section-title">
+      Positions
+      <code class="cdm-ref cdm-ref-plain ms-1" *ngIf="positions?.cdmRef">{{ positions?.cdmRef }}</code>
+      <span *ngIf="positions?.validation as validation" class="ms-1" [ngClass]="badgeClass(validation.status)"
+            [title]="validation.messages.join('; ') || validation.status">{{ validation.status }}</span>
+    </h6>
+    <div class="text-muted small mb-1">
+      The account's CDM PortfolioState: per security, the holding and the trade states whose signed quantities sum to it.
+    </div>
+    <table class="table table-sm cdm-table cdm-positions-table" *ngIf="positions?.positions?.length; else noPositions">
+      <thead><tr><th>Security</th><th class="text-end">Quantity</th><th>Trade states</th></tr></thead>
+      <tbody>
+        <ng-container *ngFor="let position of positions?.positions">
+          <tr class="cdm-position">
+            <td class="cdm-position-security">{{ position.security }}</td>
+            <td class="text-end cdm-position-quantity">{{ formatQuantity(position.quantity) }}</td>
+            <td>
+              <button type="button" class="btn btn-link btn-sm p-0 cdm-position-toggle" (click)="togglePosition(position)"
+                      [attr.aria-expanded]="expandedPositions.has(position.security)">
+                {{ expandedPositions.has(position.security) ? 'Hide' : 'Show' }} {{ position.trades.length }} trade state{{ position.trades.length === 1 ? '' : 's' }}
+              </button>
+            </td>
+          </tr>
+          <tr *ngIf="expandedPositions.has(position.security)" class="cdm-position-trades-row">
+            <td colspan="3">
+              <table class="table table-sm mb-1 cdm-position-trades">
+                <thead><tr><th>Trade</th><th>Side</th><th class="text-end">Signed qty</th><th class="text-end">Price</th><th>Executed</th></tr></thead>
+                <tbody>
+                  <tr *ngFor="let trade of position.trades" class="cdm-position-trade">
+                    <td><a [routerLink]="cdmViewPath('trade', trade.tradeId, trade.cdmRef)"><code>{{ trade.tradeId }}</code></a></td>
+                    <td>{{ trade.side || '-' }}</td>
+                    <td class="text-end cdm-signed-quantity">{{ trade.signedQuantity > 0 ? '+' : '' }}{{ formatQuantity(trade.signedQuantity) }}</td>
+                    <td class="text-end">{{ formatPrice(trade.price) }}</td>
+                    <td class="text-nowrap cdm-executed-at">
+                      <ng-container *ngIf="isoTimeOrNull(trade.executedAt) as executedAt; else noTime">{{ executedAt | date:'yyyy-MM-dd HH:mm:ss':'UTC' }}</ng-container>
+                      <ng-template #noTime>-</ng-template>
+                    </td>
+                  </tr>
+                </tbody>
+              </table>
+              <div class="cdm-position-sum">
+                Sum of trade states: {{ formatQuantity(tradeSum(position)) }}
+                <span *ngIf="tradeSum(position) === position.quantity" class="text-success">· matches the holding</span>
+                <span *ngIf="tradeSum(position) !== position.quantity" class="text-danger">· differs from the holding {{ formatQuantity(position.quantity) }}</span>
+              </div>
+            </td>
+          </tr>
+        </ng-container>
+      </tbody>
+    </table>
+    <ng-template #noPositions>
+      <div class="text-muted small">{{ positionsError ? 'CDM positions are unavailable.' : positionsPending ? 'No CDM trades for this account yet.' : (positions ? 'No positions for this account.' : 'Loading positions…') }}</div>
+    </ng-template>
+  </section>
+
+  <section class="mt-3">
+    <h6 class="cdm-section-title">Rejected order requests</h6>
+    <table class="table table-sm cdm-table cdm-rejections" *ngIf="rejections.length; else noRejections">
+      <thead><tr><th>Rejection</th><th>When</th><th class="text-end">Qty</th><th>Reason</th><th>CDM</th></tr></thead>
+      <tbody>
+        <tr *ngFor="let rejection of rejections">
+          <td><a [routerLink]="cdmViewPath('order', rejection.rejectionId, rejection.cdmRef)"><code>{{ rejection.rejectionId }}</code></a></td>
+          <td class="text-nowrap">{{ rejection.rejectedAt | date:'yyyy-MM-dd HH:mm:ss':'UTC' }}</td>
+          <td class="text-end">{{ formatQuantity(rejection.quantity) }}</td>
+          <td>{{ rejection.reason }}</td>
+          <td><span [ngClass]="badgeClass(rejection.validation.status)" [title]="rejection.validation.messages.join('; ')">{{ rejection.validation.status }}</span></td>
+        </tr>
+      </tbody>
+    </table>
+    <ng-template #noRejections><div class="text-muted small">No rejected order requests for this account.</div></ng-template>
+  </section>
+
+  <section class="mt-4 cdm-relationships" *ngIf="entities.length">
+    <h6 class="cdm-section-title">Trading relationships</h6>
+    <div class="text-muted small mb-2">
+      Each client account is serviced by one TraderX subsidiary (CDM <code>Account.servicingParty</code>), which is the
+      dealer (<code>Party1</code>) of the client's orders and trades; the client is <code>Party2</code>.
+    </div>
+    <table class="table table-sm cdm-table">
+      <thead><tr><th>Subsidiary</th><th>cdmRef</th><th>Clients</th></tr></thead>
+      <tbody>
+        <tr *ngFor="let row of relationships()" [attr.data-entity]="row.key">
+          <td class="fw-semibold">{{ row.name }}</td>
+          <td><code class="cdm-ref" *ngIf="row.key">cdm:party:{{ row.key }}</code></td>
+          <td>
+            <span *ngFor="let client of row.accounts; let last = last">
+              <a href="" (click)="$event.preventDefault(); onAccountChange(client)"
+                 [class.fw-semibold]="client.id === account?.id">{{ client.displayName }}</a>
+              <span class="text-muted small"> ({{ client.id }})</span><span *ngIf="!last">, </span>
+            </span>
+            <span *ngIf="!row.accounts.length" class="text-muted small">none</span>
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  </section>
+
+  <ng-template #badgeLoading><span class="text-muted small">…</span></ng-template>
+</div>
