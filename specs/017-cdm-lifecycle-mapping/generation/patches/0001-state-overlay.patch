+package finos.traderx.ordermatcher.service;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import finos.traderx.messaging.PubSubException;
+import finos.traderx.messaging.Publisher;
+import finos.traderx.ordermatcher.api.OrderCreateRequest;
+import finos.traderx.ordermatcher.api.OrderResponse;
+import finos.traderx.ordermatcher.api.RejectedOrder;
+import finos.traderx.ordermatcher.model.OrderRecord;
+import finos.traderx.ordermatcher.model.OrderSide;
+import finos.traderx.ordermatcher.model.OrderStatus;
+import finos.traderx.ordermatcher.repository.OrderRepository;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.client.RestTemplate;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+class OrderMatcherServiceCdmLinkTest {
+    private OrderRepository repository;
+    private Publisher<OrderResponse> orderPublisher;
+    private Publisher<RejectedOrder> rejectedPublisher;
+    private RestTemplate restTemplate;
+    private OrderMatcherService service;
+
+    @BeforeEach
+    @SuppressWarnings("unchecked")
+    void setUp() {
+        repository = mock(OrderRepository.class);
+        orderPublisher = mock(Publisher.class);
+        rejectedPublisher = mock(Publisher.class);
+        restTemplate = mock(RestTemplate.class);
+        when(repository.save(any(OrderRecord.class))).thenAnswer(call -> call.getArgument(0));
+        service = new OrderMatcherService(repository, orderPublisher, rejectedPublisher, restTemplate,
+            false, "", "http://price", "http://trade-service/trade/", 1000, 1000);
+    }
+
+    private OrderRecord openOrder(String orderId) {
+        OrderRecord order = new OrderRecord();
+        order.setOrderId(orderId);
+        order.setAccountId(22214);
+        order.setSecurity("IBM");
+        order.setSide(OrderSide.Buy);
+        order.setQuantity(100);
+        order.setRemainingQuantity(100);
+        order.setLimitPrice(new BigDecimal("187.250"));
+        order.setStatus(OrderStatus.NEW);
+        order.setCreatedAt(Instant.now());
+        order.setUpdatedAt(Instant.now());
+        return order;
+    }
+
+    @Test
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    void fillSubmitsTradeWithOrderId() {
+        when(repository.findById("ord-013-0042")).thenReturn(Optional.of(openOrder("ord-013-0042")));
+        when(restTemplate.postForEntity(anyString(), any(), eq(Map.class))).thenReturn(ResponseEntity.ok(Map.of()));
+
+        service.forceFillOrder("ord-013-0042");
+
+        ArgumentCaptor<Object> body = ArgumentCaptor.forClass(Object.class);
+        verify(restTemplate).postForEntity(eq("http://trade-service/trade/"), body.capture(), eq(Map.class));
+        Map<String, Object> payload = (Map<String, Object>) body.getValue();
+        assertEquals("ord-013-0042", payload.get("orderId"));
+        // Existing fields are unchanged.
+        assertEquals("IBM", payload.get("security"));
+        assertEquals(100, payload.get("quantity"));
+        assertEquals(22214, payload.get("accountId"));
+        assertEquals("Buy", payload.get("side"));
+    }
+
+    @Test
+    void invalidCreatePublishesRejectedAndStillReturns400() throws Exception {
+        OrderCreateRequest request = new OrderCreateRequest();
+        request.setAccountId(22214);
+        request.setSecurity("IBM");
+        request.setSide(OrderSide.Sell);
+        request.setQuantity(0);
+        request.setLimitPrice(new BigDecimal("10.5"));
+
+        ResponseStatusException thrown = assertThrows(ResponseStatusException.class, () -> service.createOrder(request));
+        assertEquals(400, thrown.getStatusCode().value());
+        assertEquals("invalid order payload", thrown.getReason());
+
+        ArgumentCaptor<RejectedOrder> captor = ArgumentCaptor.forClass(RejectedOrder.class);
+        verify(rejectedPublisher).publish(eq("/orders/rejected"), captor.capture());
+        RejectedOrder rejected = captor.getValue();
+        assertTrue(rejected.getRejectionId().matches("^rej-[0-9a-f-]{36}$"), rejected.getRejectionId());
+        assertEquals(22214, rejected.getAccountId());
+        assertEquals("IBM", rejected.getSecurity());
+        assertEquals("Sell", rejected.getSide());
+        assertEquals(0, rejected.getQuantity());
+        assertEquals(new BigDecimal("10.5"), rejected.getLimitPrice());
+        assertEquals("invalid order payload", rejected.getReason());
+        assertNotNull(rejected.getRejectedAt());
+    }
+
+    @Test
+    void nullCreateRequestPublishesRejectionWithNullFields() throws Exception {
+        assertThrows(ResponseStatusException.class, () -> service.createOrder(null));
+        ArgumentCaptor<RejectedOrder> captor = ArgumentCaptor.forClass(RejectedOrder.class);
+        verify(rejectedPublisher).publish(eq("/orders/rejected"), captor.capture());
+        RejectedOrder rejected = captor.getValue();
+        assertNull(rejected.getAccountId());
+        assertNull(rejected.getSecurity());
+        assertNull(rejected.getSide());
+        assertNull(rejected.getQuantity());
+        assertNull(rejected.getLimitPrice());
+        assertEquals("invalid order payload", rejected.getReason());
+
+        // Nullable fields stay present (as null) on the wire so consumers see a stable shape.
+        JsonNode json = JsonMapper.builder().build().valueToTree(rejected);
+        for (String field : new String[] {"rejectionId", "accountId", "security", "side", "quantity", "limitPrice", "reason", "rejectedAt"}) {
+            assertTrue(json.has(field), "missing " + field);
+        }
+    }
+
+    @Test
+    void rejectionPublishFailureDoesNotChangeThe400() throws Exception {
+        doThrow(new PubSubException("nats down")).when(rejectedPublisher).publish(anyString(), any(RejectedOrder.class));
+        ResponseStatusException thrown = assertThrows(ResponseStatusException.class, () -> service.createOrder(new OrderCreateRequest()));
+        assertEquals(400, thrown.getStatusCode().value());
+        assertEquals("invalid order payload", thrown.getReason());
+
+        doThrow(new IllegalStateException("disconnected")).when(rejectedPublisher).publish(anyString(), any(RejectedOrder.class));
+        thrown = assertThrows(ResponseStatusException.class, () -> service.createOrder(new OrderCreateRequest()));
+        assertEquals(400, thrown.getStatusCode().value());
+    }
+
+    @Test
+    void orderResponseCarriesCdmRef() {
+        OrderResponse response = OrderResponse.from(openOrder("ord-013-0007"), null);
+        assertEquals("cdm:order:" + response.getOrderId(), response.getCdmRef());
+        assertEquals("cdm:order:ord-013-0007", JsonMapper.builder().build().valueToTree(response).get("cdmRef").asString());
+    }
+
+    @Test
+    void canceledEventCarriesFilledAndCanceledQuantity() {
+        OrderRecord order = openOrder("ord-013-0077");
+        order.setStatus(OrderStatus.PARTIALLY_FILLED);
+        order.setRemainingQuantity(40);
+        when(repository.findById("ord-013-0077")).thenReturn(Optional.of(order));
+
+        OrderResponse partial = OrderResponse.from(order, null);
+        assertEquals(60, partial.getFilledQuantity());
+        assertNull(partial.getCanceledQuantity());
+
+        OrderResponse canceled = service.cancelOrder("ord-013-0077");
+
+        assertEquals(OrderStatus.CANCELED, canceled.getStatus());
+        assertEquals(0, canceled.getRemainingQuantity());
+        assertEquals(60, canceled.getFilledQuantity());
+        assertEquals(40, canceled.getCanceledQuantity());
+        // A later read of the canceled order still says how much was filled.
+        OrderResponse reread = OrderResponse.from(order, null);
+        assertEquals(60, reread.getFilledQuantity());
+        assertEquals(40, reread.getCanceledQuantity());
+    }
+}
