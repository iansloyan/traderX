diff --git a/account-service/src/main/java/finos/traderx/accountservice/client/CdmServiceClient.java b/account-service/src/main/java/finos/traderx/accountservice/client/CdmServiceClient.java
new file mode 100644
index 0000000..d4ff67c
--- /dev/null
+++ b/account-service/src/main/java/finos/traderx/accountservice/client/CdmServiceClient.java
@@ -0,0 +1,128 @@
+package finos.traderx.accountservice.client;
+
+import finos.traderx.accountservice.exceptions.CdmServiceClientErrorException;
+import finos.traderx.accountservice.exceptions.CdmServiceUnavailableException;
+import finos.traderx.accountservice.model.Account;
+import finos.traderx.accountservice.model.AccountUser;
+import java.net.http.HttpClient;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.function.Supplier;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.client.JdkClientHttpRequestFactory;
+import org.springframework.stereotype.Component;
+import org.springframework.web.client.HttpClientErrorException;
+import org.springframework.web.client.RestClient;
+import org.springframework.web.client.RestClientException;
+
+/**
+ * Reads and writes accounts and account users in cdm-service's party master (state 017: CDM
+ * {@code Party}/{@code NaturalPerson} are authoritative). Base URL {@code CDM_SERVICE_URL}
+ * (default {@code http://cdm-service:18120}), timeout {@code CDM_SERVICE_TIMEOUT_MS}.
+ *
+ * <p>A 404 from cdm-service is "not found" ({@link Optional#empty()}). Any other 4xx (400 invalid
+ * input, 409 no free id) is a {@link CdmServiceClientErrorException} that the controllers answer
+ * with the same status. Everything else that is not a 2xx (connection refused, timeout, 503 while
+ * cdm-service is still seeding, 5xx) is a {@link CdmServiceUnavailableException}, answered 503.
+ */
+@Component
+public class CdmServiceClient {
+
+  private final RestClient rest;
+
+  @Autowired
+  public CdmServiceClient(@Value("${cdm.service.url}") String baseUrl,
+      @Value("${cdm.service.timeout-ms:5000}") long timeoutMs) {
+    Duration timeout = Duration.ofMillis(timeoutMs);
+    JdkClientHttpRequestFactory requests = new JdkClientHttpRequestFactory(
+        HttpClient.newBuilder().connectTimeout(timeout).build());
+    requests.setReadTimeout(timeout);
+    this.rest = RestClient.builder().baseUrl(baseUrl).requestFactory(requests).build();
+  }
+
+  public List<Account> listAccounts() {
+    return call(() -> Arrays.asList(rest.get().uri("/projections/accounts")
+        .retrieve().body(Account[].class)));
+  }
+
+  public Optional<Account> findAccount(int id) {
+    return callOrNotFound(() -> rest.get().uri("/projections/accounts/{id}", id)
+        .retrieve().body(Account.class));
+  }
+
+  /** Creates an account; cdm-service assigns the id (from {@code accounts_seq}). */
+  public Account createAccount(String displayName) {
+    return call(() -> rest.post().uri("/projections/accounts")
+        .contentType(MediaType.APPLICATION_JSON)
+        .body(fields("displayName", displayName))
+        .retrieve().body(Account.class));
+  }
+
+  /** Updates account {@code id}, creating it with that id if it does not exist. */
+  public Account upsertAccount(int id, String displayName) {
+    return call(() -> rest.put().uri("/projections/accounts/{id}", id)
+        .contentType(MediaType.APPLICATION_JSON)
+        .body(fields("displayName", displayName))
+        .retrieve().body(Account.class));
+  }
+
+  /** Account users ordered by account id then username; one account's if given. */
+  public List<AccountUser> listAccountUsers(Integer accountId) {
+    return call(() -> Arrays.asList((accountId == null
+        ? rest.get().uri("/projections/accountusers")
+        : rest.get().uri("/projections/accountusers?accountId={id}", accountId))
+        .retrieve().body(AccountUser[].class)));
+  }
+
+  /** Relates a user to an account; empty if the account does not exist. */
+  public Optional<AccountUser> addAccountUser(int accountId, String username) {
+    return callOrNotFound(() -> rest.post().uri("/projections/accountusers")
+        .contentType(MediaType.APPLICATION_JSON)
+        .body(fields("accountId", accountId, "username", username))
+        .retrieve().body(AccountUser.class));
+  }
+
+  /** A JSON object body that, unlike {@link Map#of}, keeps null values (as null). */
+  private static Map<String, Object> fields(Object... keysAndValues) {
+    Map<String, Object> body = new LinkedHashMap<>();
+    for (int i = 0; i < keysAndValues.length; i += 2) {
+      body.put((String) keysAndValues[i], keysAndValues[i + 1]);
+    }
+    return body;
+  }
+
+  private <T> Optional<T> callOrNotFound(Supplier<T> request) {
+    try {
+      return Optional.ofNullable(call(request));
+    } catch (CdmServiceClientErrorException e) {
+      if (e.getStatus() == HttpStatus.NOT_FOUND.value()) {
+        return Optional.empty();
+      }
+      throw e;
+    }
+  }
+
+  private static <T> T call(Supplier<T> request) {
+    T body;
+    try {
+      body = request.get();
+    } catch (HttpClientErrorException e) {
+      String message = e.getResponseBodyAsString();
+      throw new CdmServiceClientErrorException(e.getStatusCode().value(),
+          message.isBlank() ? e.getStatusText() : message, e);
+    } catch (RestClientException e) {
+      throw new CdmServiceUnavailableException("cdm-service unavailable: " + e.getMessage(), e);
+    }
+    if (body == null) {
+      throw new CdmServiceUnavailableException("cdm-service returned an empty body", null);
+    }
+    return body;
+  }
+}
