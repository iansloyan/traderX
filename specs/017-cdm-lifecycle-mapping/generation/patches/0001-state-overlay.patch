+import { Component, OnDestroy, OnInit } from '@angular/core';
+import { ActivatedRoute, convertToParamMap, ParamMap } from '@angular/router';
+import { HttpErrorResponse } from '@angular/common/http';
+import { combineLatest, Observable, of, Subscription } from 'rxjs';
+import { catchError, map, switchMap } from 'rxjs/operators';
+import {
+    CdmFill,
+    CdmLineageStep,
+    CdmOrderLineage,
+    CdmResult,
+    CdmService,
+    CdmStoredObject,
+    CdmTrade,
+    CdmTradeLineage,
+    CdmTradeStateSummary,
+    CdmValidation
+} from './cdm.service';
+import {
+    badgeClass,
+    findAccountId,
+    findTicker,
+    formatPrice,
+    formatQuantity,
+    partyView,
+    PartyView,
+    refKey,
+    securityView,
+    SecurityView,
+    toNumber,
+    unwrap,
+    VENUE_KEY,
+    worstValidation
+} from './cdm-presentation';
+
+export type CdmViewKind = 'order' | 'trade';
+export type CdmViewState = 'loading' | 'pending' | 'pending-timeout' | 'ready' | 'error';
+
+const TRADE_STATE_TYPE = 'cdm.event.common.TradeState';
+
+/** Step-level fields shown first in a WorkflowStep's raw JSON, before its proposedEvent/businessEvent. */
+const STEP_FIELDS_FIRST = ['eventIdentifier', 'previousWorkflowStep', 'action', 'workflowState', 'timestamp', 'approval'];
+
+/** A copy of a WorkflowStep with its step-level fields first; any other object unchanged. */
+export function stepFieldsFirst(object: any): any {
+    if (!object || typeof object !== 'object' || !('eventIdentifier' in object)
+        || !('proposedEvent' in object || 'businessEvent' in object)) {
+        return object;
+    }
+    const ordered: any = {};
+    for (const key of STEP_FIELDS_FIRST) {
+        if (key in object) {
+            ordered[key] = object[key];
+        }
+    }
+    for (const key of Object.keys(object)) {
+        if (!(key in ordered)) {
+            ordered[key] = object[key];
+        }
+    }
+    return ordered;
+}
+
+/** One stored CDM object the page can select: a WorkflowStep, or a trade's TradeState. */
+export interface ChainNode {
+    id: string;
+    nodeType: 'step' | 'tradeState';
+    stepType: string;
+    label: string;
+    detail: string | null;
+    timestamp: string | null;
+    validation: CdmValidation | null;
+    cdmRef: string;
+    cdmType: string | null;
+    storeGlobalKey: string | null;
+    cdmGlobalKey: string | null;
+    previousStoreGlobalKey: string | null;
+    object: any;
+}
+
+/** One fill of an order, drawn inside the order proposal: its two steps and the trade state they produced. */
+export interface FillView {
+    fill: CdmFill;
+    /** "Partial fill N (qty @ price) · X of Y filled", from the API's label and running total. */
+    title: string;
+    steps: ChainNode[];
+    tradeState: ChainNode | null;
+    /** Worst result over the fill's steps and trade state. */
+    validation: CdmValidation | null;
+    highlight: boolean;
+}
+
+export interface ApprovalView {
+    text: string;
+    approved: boolean | null;
+}
+
+/** The order page: the proposal (its versions and the venue's answer) with its fills nested inside, then the cancel. */
+export interface OrderTree {
+    versions: ChainNode[];
+    /** The latest proposal version: what selecting the proposal shows. */
+    proposal: ChainNode | null;
+    validation: CdmValidation | null;
+    approval: ApprovalView;
+    executionType: string | null;
+    executionTypeMeaning: string | null;
+    fills: FillView[];
+    cancel: ChainNode | null;
+}
+
+/** The trade page: the trade state first, then the workflow that produced it. */
+export interface TradePage {
+    lineage: CdmTradeLineage;
+    tradeState: ChainNode | null;
+    producerSteps: ChainNode[];
+}
+
+/** Quantities shown above the tree; null where the view has no such quantity to show. */
+export interface CdmQuantities {
+    instruction: number | null;
+    executed: number;
+    canceled: number | null;
+    remaining: number | null;
+    status: string;
+}
+
+type Loaded =
+    | { status: 'pending'; cdmRef: string | null }
+    | { status: 'order'; order: CdmOrderLineage }
+    | { status: 'trade'; lineage: CdmTradeLineage; trade: CdmTrade | null };
+
+/**
+ * CDM view (state 017) of one TraderX order or trade (`/cdm/order/:id`, `/cdm/trade/:id`).
+ *
+ * An order is drawn as a tree, not a sequence: the order proposal (its versions and the venue's
+ * approval or rejection), the fills nested beneath it, each with its own proposed and accepted steps
+ * and the trade state its execution produced, then the cancel. `?fill=N` highlights one fill.
+ * A trade leads with its TradeState, then what produced it: a fill of an order (linked to the order
+ * page with that fill highlighted) or a direct trade's own workflow. Every stored object can be
+ * selected to see its keys, validation and raw CDM JSON. A 404 {"status":"pending"} (the lifecycle
+ * adapter has not stored the object yet) shows a "being built" state and is retried for a short time.
+ */
+@Component({
+    standalone: false,
+    selector: 'app-cdm-view',
+    templateUrl: './cdm-view.component.html',
+    styleUrls: ['./cdm-view.component.scss']
+})
+export class CdmViewComponent implements OnInit, OnDestroy {
+    static readonly RETRY_INTERVAL_MS = 2000;
+    static readonly MAX_PENDING_RETRIES = 15;
+
+    kind: CdmViewKind | null = null;
+    id = '';
+    highlightFill: number | null = null;
+    state: CdmViewState = 'loading';
+    errorMessage = '';
+    pendingRef: string | null = null;
+    pendingAttempts = 0;
+
+    order: CdmOrderLineage | null = null;
+    tree: OrderTree | null = null;
+    tradePage: TradePage | null = null;
+    nodes: ChainNode[] = [];
+    selected: ChainNode | null = null;
+    expandedFills = new Set<number>();
+    expandedMessages = new Set<string>();
+    showJson = true;
+    copied = false;
+
+    accountId: number | null = null;
+    ticker: string | null = null;
+    companyName: string | null = null;
+    accountParty: PartyView | null = null;
+    /** The facing subsidiary on this order or trade (Party1), from the lineage. */
+    dealer: { cdmRef: string; name: string | null } | null = null;
+    venueParty: PartyView | null = null;
+    /** The TraderX subsidiaries a client can be serviced by (for the selector). */
+    entities: PartyView[] = [];
+    servicingSaving = false;
+    servicingError: string | null = null;
+    security: SecurityView | null = null;
+    partyError = false;
+    securityError = false;
+
+    readonly badgeClass = badgeClass;
+    readonly formatQuantity = formatQuantity;
+    readonly formatPrice = formatPrice;
+
+    private routeSub?: Subscription;
+    private loadSub?: Subscription;
+    private refSubs: Subscription[] = [];
+    private retryTimer: ReturnType<typeof setTimeout> | null = null;
+    private copiedTimer: ReturnType<typeof setTimeout> | null = null;
+
+    constructor(private route: ActivatedRoute, private cdm: CdmService) {}
+
+    ngOnInit(): void {
+        const query$: Observable<ParamMap> = this.route.queryParamMap ?? of(convertToParamMap({}));
+        this.routeSub = combineLatest([this.route.paramMap, query$]).subscribe(([params, query]) => {
+            const kind = String(params.get('kind') ?? '').toLowerCase();
+            this.kind = kind === 'order' || kind === 'trade' ? kind : null;
+            this.id = params.get('id') ?? '';
+            this.reset();
+            this.highlightFill = toNumber(query.get('fill'));
+            if (!this.kind || !this.id) {
+                this.state = 'error';
+                this.errorMessage = `Unknown CDM view "${kind}". Use /cdm/order/<orderId> or /cdm/trade/<tradeId>.`;
+                return;
+            }
+            this.load();
+        });
+    }
+
+    ngOnDestroy(): void {
+        this.routeSub?.unsubscribe();
+        this.cancelLoads();
+        if (this.copiedTimer !== null) {
+            clearTimeout(this.copiedTimer);
+        }
+    }
+
+    get cdmRef(): string {
+        return `cdm:${this.kind ?? 'order'}:${this.id}`;
+    }
+
+    /**
+     * The order's quantities; for a trade only the executed quantity of its trade state, since a
+     * trade has no instruction, remainder or cancel to report.
+     */
+    get quantities(): CdmQuantities | null {
+        if (this.order) {
+            return {
+                instruction: this.order.instructionQuantity,
+                executed: this.order.executedQuantity,
+                canceled: this.order.canceledQuantity,
+                remaining: this.order.remainingQuantity,
+                status: this.order.status
+            };
+        }
+        const tradeState = this.tradePage?.lineage.tradeState;
+        if (!tradeState) {
+            return null;
+        }
+        return {
+            instruction: null,
+            executed: tradeState.quantity ?? 0,
+            canceled: null,
+            remaining: null,
+            status: tradeState.positionState ?? 'executed'
+        };
+    }
+
+    get hasFailures(): boolean {
+        return (this.order?.failures?.length ?? 0) > 0;
+    }
+
+    get hasPending(): boolean {
+        return (this.order?.pending?.trades?.length ?? 0) > 0 || !!this.order?.pending?.cancel;
+    }
+
+    /**
+     * Raw JSON of the selected object. For a WorkflowStep the step's own fields (identifiers, the link to
+     * the previous step, action, status) come before its long proposedEvent/businessEvent, so they are
+     * visible without scrolling; JSON field order has no meaning, so the object is unchanged.
+     */
+    get selectedJson(): string {
+        if (!this.selected || this.selected.object == null) {
+            return '';
+        }
+        return JSON.stringify(stepFieldsFirst(this.selected.object), null, 2);
+    }
+
+    /** Identifiers of the selected object: a step's eventIdentifier, or a trade state's tradeIdentifier. */
+    get selectedIdentifiers(): { scheme: string; value: string; version: number | null }[] {
+        const object = this.selected?.object;
+        const holders = object?.eventIdentifier ?? object?.trade?.tradeIdentifier ?? [];
+        return (Array.isArray(holders) ? holders : []).flatMap((holder: any) => (holder?.assignedIdentifier ?? [])
+            .map((assigned: any) => ({
+                scheme: String(assigned?.identifier?.meta?.scheme ?? '').replace(/^https:\/\/traderx\.finos\.org\//, ''),
+                value: String(assigned?.identifier?.value ?? ''),
+                version: assigned?.version ?? null
+            })))
+            .filter((identifier: { value: string }) => identifier.value);
+    }
+
+    /** The selected step's CDM previousWorkflowStep (key and external reference), if any. */
+    get selectedPreviousStep(): { globalReference: string | null; externalReference: string | null } | null {
+        const previous = this.selected?.object?.previousWorkflowStep;
+        return previous ? { globalReference: previous.globalReference ?? null, externalReference: previous.externalReference ?? null } : null;
+    }
+
+    select(node: ChainNode | null, event?: Event): void {
+        event?.stopPropagation();
+        if (!node) {
+            return;
+        }
+        this.selected = node;
+        this.copied = false;
+    }
+
+    isFillExpanded(fill: FillView): boolean {
+        return this.expandedFills.has(fill.fill.fillNumber);
+    }
+
+    toggleFill(fill: FillView, event?: Event): void {
+        event?.stopPropagation();
+        if (this.expandedFills.has(fill.fill.fillNumber)) {
+            this.expandedFills.delete(fill.fill.fillNumber);
+        } else {
+            this.expandedFills.add(fill.fill.fillNumber);
+        }
+    }
+
+    /** Whether the selection is one of the fill's stored objects. */
+    fillSelected(fill: FillView): boolean {
+        return !!this.selected && (fill.steps.includes(this.selected) || fill.tradeState === this.selected);
+    }
+
+    toggleMessages(node: ChainNode, event?: Event): void {
+        event?.stopPropagation();
+        if (this.expandedMessages.has(node.id)) {
+            this.expandedMessages.delete(node.id);
+        } else {
+            this.expandedMessages.add(node.id);
+        }
+    }
+
+    validationTitle(validation: CdmValidation | null | undefined): string {
+        if (!validation) {
+            return 'not validated';
+        }
+        return validation.messages?.length ? validation.messages.join('\n') : `${validation.status}: no messages`;
+    }
+
+    copyJson(): void {
+        const text = this.selectedJson;
+        if (!text || !navigator?.clipboard) {
+            return;
+        }
+        navigator.clipboard.writeText(text).then(() => {
+            this.copied = true;
+            if (this.copiedTimer !== null) {
+                clearTimeout(this.copiedTimer);
+            }
+            this.copiedTimer = setTimeout(() => (this.copied = false), 1500);
+        }).catch(() => undefined);
+    }
+
+    retryNow(): void {
+        this.pendingAttempts = 0;
+        this.state = 'loading';
+        this.load();
+    }
+
+    trackNode(_: number, node: ChainNode): string {
+        return node.id;
+    }
+
+    trackFill(_: number, fill: FillView): number {
+        return fill.fill.fillNumber;
+    }
+
+    // --- loading ---------------------------------------------------------------------------------
+
+    private reset(): void {
+        this.cancelLoads();
+        this.state = 'loading';
+        this.errorMessage = '';
+        this.pendingRef = null;
+        this.pendingAttempts = 0;
+        this.highlightFill = null;
+        this.order = null;
+        this.tree = null;
+        this.tradePage = null;
+        this.nodes = [];
+        this.selected = null;
+        this.expandedFills.clear();
+        this.expandedMessages.clear();
+        this.accountId = null;
+        this.ticker = null;
+        this.companyName = null;
+        this.accountParty = null;
+        this.dealer = null;
+        this.venueParty = null;
+        this.servicingError = null;
+        this.security = null;
+        this.partyError = false;
+        this.securityError = false;
+    }
+
+    private cancelLoads(): void {
+        this.loadSub?.unsubscribe();
+        this.loadSub = undefined;
+        this.refSubs.forEach((sub) => sub.unsubscribe());
+        this.refSubs = [];
+        if (this.retryTimer !== null) {
+            clearTimeout(this.retryTimer);
+            this.retryTimer = null;
+        }
+    }
+
+    private load(): void {
+        this.loadSub?.unsubscribe();
+        const source: Observable<Loaded> = this.kind === 'order' ? this.loadOrder(this.id) : this.loadTrade(this.id);
+        this.loadSub = source.subscribe({
+            next: (loaded) => this.onLoaded(loaded),
+            error: (error: HttpErrorResponse) => {
+                this.state = 'error';
+                this.errorMessage = error?.status
+                    ? `cdm-service answered ${error.status} ${error.statusText || ''}`.trim()
+                    : 'cdm-service is not reachable';
+            }
+        });
+    }
+
+    private loadOrder(orderId: string): Observable<Loaded> {
+        return this.cdm.orderLineage(orderId).pipe(
+            map((result): Loaded => result.status === 'pending'
+                ? { status: 'pending', cdmRef: result.cdmRef }
+                : { status: 'order', order: result.data })
+        );
+    }
+
+    /** The trade lineage (trade state + producer) and, for the raw JSON, the stored trade state. */
+    private loadTrade(tradeId: string): Observable<Loaded> {
+        return this.cdm.tradeLineage(tradeId).pipe(
+            switchMap((result): Observable<Loaded> => {
+                if (result.status === 'pending') {
+                    return of({ status: 'pending', cdmRef: result.cdmRef });
+                }
+                // The lineage loaded: show it even if the stored object cannot be read.
+                const trade$ = this.cdm.trade(tradeId).pipe(
+                    map((r) => (r.status === 'ok' ? r.data : null)),
+                    catchError(() => of(null)));
+                return trade$.pipe(map((trade): Loaded => ({ status: 'trade', lineage: result.data, trade })));
+            })
+        );
+    }
+
+    private onLoaded(loaded: Loaded): void {
+        if (loaded.status === 'pending') {
+            this.pendingRef = loaded.cdmRef ?? this.cdmRef;
+            this.pendingAttempts++;
+            if (this.pendingAttempts > CdmViewComponent.MAX_PENDING_RETRIES) {
+                this.state = 'pending-timeout';
+                return;
+            }
+            this.state = 'pending';
+            this.retryTimer = setTimeout(() => {
+                this.retryTimer = null;
+                this.load();
+            }, CdmViewComponent.RETRY_INTERVAL_MS);
+            return;
+        }
+        if (loaded.status === 'order') {
+            this.order = loaded.order;
+            this.tree = this.orderTree(loaded.order);
+            this.nodes = [
+                ...this.tree.versions,
+                ...this.tree.fills.flatMap((fill) => [...fill.steps, ...(fill.tradeState ? [fill.tradeState] : [])]),
+                ...(this.tree.cancel ? [this.tree.cancel] : [])
+            ];
+            const highlighted = this.tree.fills.find((fill) => fill.highlight);
+            this.selected = (highlighted ? highlighted.steps[highlighted.steps.length - 1] : null)
+                ?? this.tree.cancel ?? this.tree.proposal ?? null;
+        } else {
+            this.tradePage = this.tradeView(loaded.lineage, loaded.trade);
+            this.nodes = [...(this.tradePage.tradeState ? [this.tradePage.tradeState] : []), ...this.tradePage.producerSteps];
+            this.selected = this.nodes[0] ?? null;
+        }
+        this.state = 'ready';
+        this.loadReferenceData();
+    }
+
+    // --- order tree ------------------------------------------------------------------------------
+
+    private orderTree(order: CdmOrderLineage): OrderTree {
+        const proposal = order.proposal;
+        const versions = (proposal?.versions ?? []).map((step) => this.stepNode(step, order.cdmRef, order));
+        const fills = (order.fills ?? []).map((fill) => this.fillView(fill, order));
+        for (const fill of fills) {
+            if (fill.highlight || (fill.validation && fill.validation.status !== 'VALID')) {
+                this.expandedFills.add(fill.fill.fillNumber);
+            }
+        }
+        return {
+            versions,
+            proposal: versions[versions.length - 1] ?? null,
+            validation: worstValidation(versions.map((node) => node.validation)),
+            approval: this.approvalView(order),
+            executionType: proposal?.executionType ?? null,
+            executionTypeMeaning: proposal?.executionTypeMeaning ?? null,
+            fills,
+            cancel: order.cancel ? this.stepNode(order.cancel, order.cdmRef, order) : null
+        };
+    }
+
+    /** "Approved by <venue>", "Rejected: <reason>", or awaiting the venue's answer. */
+    approvalView(order: CdmOrderLineage): ApprovalView {
+        const approval = order.proposal?.approval;
+        if (!approval) {
+            return { text: 'Awaiting venue approval', approved: null };
+        }
+        if (!approval.approved) {
+            return { text: `Rejected: ${approval.rejectedReason || 'no reason given'}`, approved: false };
+        }
+        const venue = order.parties?.venue;
+        const name = venue && (!approval.party || venue.cdmRef === approval.party) && venue.name
+            ? venue.name
+            : refKey(approval.party, 'party') ?? 'the venue';
+        return { text: `Approved by ${name}`, approved: true };
+    }
+
+    private fillView(fill: CdmFill, order: CdmOrderLineage): FillView {
+        const steps = [fill.proposed, fill.accepted]
+            .filter((step): step is CdmLineageStep => !!step)
+            .map((step) => this.stepNode(step, order.cdmRef, order));
+        const tradeState = fill.tradeState ? this.tradeStateSummaryNode(fill.tradeState, fill.tradeId) : null;
+        const progress = fill.filledSoFar != null
+            ? ` · ${formatQuantity(fill.filledSoFar)} of ${formatQuantity(order.instructionQuantity)} filled`
+            : '';
+        return {
+            fill,
+            title: `${fill.label} (${formatQuantity(fill.quantity)} @ ${formatPrice(fill.price)})${progress}`,
+            steps,
+            tradeState,
+            validation: worstValidation([...steps.map((node) => node.validation), tradeState?.validation]),
+            highlight: this.highlightFill != null && fill.fillNumber === this.highlightFill
+        };
+    }
+
+    private stepNode(step: CdmLineageStep, cdmRef: string, order: CdmOrderLineage | null): ChainNode {
+        const { label, detail } = this.describeStep(step, order);
+        return {
+            id: `step:${step.storeGlobalKey}`,
+            nodeType: 'step',
+            stepType: step.stepType,
+            label,
+            detail,
+            timestamp: step.timestamp ?? null,
+            validation: step.validation ?? null,
+            cdmRef,
+            cdmType: step.cdmType ?? null,
+            storeGlobalKey: step.storeGlobalKey ?? null,
+            cdmGlobalKey: step.cdmGlobalKey ?? null,
+            previousStoreGlobalKey: step.previousStoreGlobalKey ?? null,
+            object: step.object ?? null
+        };
+    }
+
+    /** Label and one-line explanation of a WorkflowStep by the role cdm-service derived for it. */
+    describeStep(step: CdmLineageStep, order: CdmOrderLineage | null): { label: string; detail: string | null } {
+        const comment = unwrap(step.object?.workflowState?.comment) ?? null;
+        switch (step.stepType) {
+            case 'proposed':
+                return {
+                    label: 'Proposed',
+                    detail: order ? 'Execution instruction proposed (WorkflowStep.proposedEvent)'
+                        : 'Trade ticket proposed (WorkflowStep.proposedEvent)'
+                };
+            case 'approved':
+                return { label: 'Approved', detail: 'Venue approval (WorkflowStep.approval); nothing executed yet' };
+            case 'rejected':
+                return { label: 'Rejected', detail: order?.proposal?.approval?.rejectedReason ?? comment };
+            case 'fill-proposed':
+                return { label: 'Proposed', detail: 'Fill instruction proposed (WorkflowStep.proposedEvent)' };
+            case 'fill-accepted':
+            case 'accepted':
+                return { label: 'Accepted', detail: 'Execution BusinessEvent; its after is the trade state' };
+            case 'cancel': {
+                const remainder = order?.canceledQuantity;
+                return {
+                    label: remainder != null ? `Cancel (remainder ${formatQuantity(remainder)})` : 'Cancel (remainder)',
+                    detail: comment
+                };
+            }
+            default:
+                return { label: step.stepType ? this.capitalize(step.stepType) : 'Step', detail: comment };
+        }
+    }
+
+    // --- trade page ------------------------------------------------------------------------------
+
+    private tradeView(lineage: CdmTradeLineage, trade: CdmTrade | null): TradePage {
+        const stored = trade?.tradeState ?? null;
+        const summary = lineage.tradeState;
+        const tradeState = stored
+            ? this.storedTradeStateNode(stored, lineage.cdmRef, summary?.positionState ?? null)
+            : summary ? this.tradeStateSummaryNode(summary, lineage.tradeId) : null;
+        const producer = lineage.producedBy;
+        const producerSteps = producer
+            ? [producer.proposed, producer.accepted]
+                .filter((step): step is CdmLineageStep => !!step)
+                .map((step) => this.stepNode(step, producer.cdmRef, null))
+            : [];
+        return { lineage, tradeState, producerSteps };
+    }
+
+    private tradeStateSummaryNode(summary: CdmTradeStateSummary & { previousStoreGlobalKey?: string | null }, tradeId: string): ChainNode {
+        return {
+            id: `tradeState:${summary.storeGlobalKey ?? tradeId}`,
+            nodeType: 'tradeState',
+            stepType: 'tradeState',
+            label: `Trade state ${tradeId}`,
+            detail: summary.positionState ? `Position state ${summary.positionState}` : null,
+            timestamp: null, // a TradeState carries dates, not timestamps
+            validation: summary.validation ?? null,
+            cdmRef: summary.cdmRef ?? `cdm:trade:${tradeId}`,
+            cdmType: TRADE_STATE_TYPE,
+            storeGlobalKey: summary.storeGlobalKey ?? null,
+            cdmGlobalKey: summary.cdmGlobalKey ?? null,
+            previousStoreGlobalKey: summary.previousStoreGlobalKey ?? null,
+            object: null
+        };
+    }
+
+    private storedTradeStateNode(stored: CdmStoredObject, cdmRef: string, positionState: string | null): ChainNode {
+        const state = positionState ?? unwrap(stored.object?.state?.positionState) ?? null;
+        return {
+            id: `tradeState:${stored.storeGlobalKey}`,
+            nodeType: 'tradeState',
+            stepType: 'tradeState',
+            label: 'Trade state',
+            detail: state ? `Position state ${state}` : null,
+            timestamp: null,
+            validation: stored.validation ?? null,
+            cdmRef,
+            cdmType: stored.cdmType ?? TRADE_STATE_TYPE,
+            storeGlobalKey: stored.storeGlobalKey ?? null,
+            cdmGlobalKey: stored.cdmGlobalKey ?? null,
+            previousStoreGlobalKey: stored.previousStoreGlobalKey ?? null,
+            object: stored.object ?? null
+        };
+    }
+
+    // --- reference data --------------------------------------------------------------------------
+
+    /** Party and security cards: from the lineage summary when present, else from the CDM objects. */
+    private loadReferenceData(): void {
+        const objects = this.nodes.map((node) => node.object).filter((object) => object != null);
+        const tradeState = this.tradePage?.lineage.tradeState ?? null;
+        this.accountId = this.order?.parties?.account?.accountId
+            ?? toNumber(refKey(tradeState?.account?.cdmRef, 'party'))
+            ?? findAccountId(objects) ?? null;
+        this.ticker = this.order?.security?.ticker ?? tradeState?.security?.ticker ?? findTicker(objects) ?? null;
+        this.companyName = this.order?.security?.companyName ?? tradeState?.security?.companyName ?? null;
+
+        if (this.accountId != null) {
+            this.refSubs.push(this.cdm.party(this.accountId).pipe(catchError(() => of(undefined))).subscribe((party) => {
+                this.accountParty = partyView(party);
+                this.partyError = party === undefined;
+            }));
+        }
+        this.dealer = this.order?.parties?.dealer ?? tradeState?.dealer ?? null;
+        // The venue is shown only where one was used (not on a direct, off-facility trade).
+        const venueRef = this.order?.parties?.venue?.cdmRef ?? tradeState?.venue?.cdmRef
+            ?? (this.order || tradeState ? null : `cdm:party:${VENUE_KEY}`);
+        const venueKey = refKey(venueRef, 'party');
+        if (venueKey) {
+            this.refSubs.push(this.cdm.party(venueKey).pipe(catchError(() => of(null))).subscribe((venue) => {
+                this.venueParty = partyView(venue);
+            }));
+        }
+        this.refSubs.push(this.cdm.entities().pipe(catchError(() => of([]))).subscribe((entities) => {
+            this.entities = (entities ?? []).map((entity) => partyView(entity)).filter((entity): entity is PartyView => entity != null);
+        }));
+        if (this.ticker) {
+            this.refSubs.push(this.cdm.security(this.ticker).pipe(catchError(() => of(undefined))).subscribe((security) => {
+                this.security = securityView(security);
+                this.securityError = security === undefined;
+            }));
+        }
+    }
+
+    /** True when the account's current servicing subsidiary is not the dealer recorded on this order or trade. */
+    dealerChanged(): boolean {
+        const current = this.accountParty?.servicingEntity;
+        const recorded = this.dealer?.cdmRef?.replace(/^cdm:party:/, '');
+        return !!current && !!recorded && current !== recorded;
+    }
+
+    /** Name of the subsidiary with this key, or the key. */
+    entityName(key: string | null): string {
+        return this.entities.find((entity) => entity.externalKey === key)?.name ?? key ?? '-';
+    }
+
+    /** Makes another subsidiary service the client; later orders and trades face it. */
+    changeServicingEntity(entity: string, select?: HTMLSelectElement): void {
+        if (this.accountId == null || !entity || entity === this.accountParty?.servicingEntity) {
+            return;
+        }
+        this.servicingSaving = true;
+        this.servicingError = null;
+        this.refSubs.push(this.cdm.setServicingParty(this.accountId, entity).subscribe({
+            next: (party) => {
+                this.accountParty = partyView(party);
+                this.servicingSaving = false;
+            },
+            error: () => {
+                this.servicingError = 'Could not change the servicing subsidiary';
+                this.servicingSaving = false;
+                // the select shows the user's choice; put it back to the subsidiary that still applies
+                if (select) {
+                    select.value = this.accountParty?.servicingEntity ?? '';
+                }
+            }
+        }));
+    }
+
+    private capitalize(value: string): string {
+        return value.charAt(0).toUpperCase() + value.slice(1);
+    }
+}
