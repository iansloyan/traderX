+    /**
+     * Which demo seed orders to insert: a comma-separated list of order statuses
+     * ({@code order.matcher.seed-statuses}). Blank means every status (the 009 seed).
+     * State 017 seeds only {@code NEW} orders, which have no fills, so cdm-service can build
+     * their CDM lineage from the matcher at startup.
+     */
+    static Set<OrderStatus> parseSeedStatuses(String value) {
+        if (value == null || value.isBlank()) {
+            return EnumSet.allOf(OrderStatus.class);
+        }
+        Set<OrderStatus> statuses = EnumSet.noneOf(OrderStatus.class);
+        for (String token : value.split(",")) {
+            String name = token.trim();
+            if (name.isEmpty()) {
+                continue;
+            }
+            try {
+                statuses.add(OrderStatus.valueOf(name.toUpperCase(Locale.ROOT)));
+            } catch (IllegalArgumentException e) {
+                throw new IllegalArgumentException(
+                    "order.matcher.seed-statuses: unknown order status '" + name + "'", e);
+            }
+        }
+        return statuses;
+    }
