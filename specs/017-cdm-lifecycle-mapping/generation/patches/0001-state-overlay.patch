+package finos.traderx.positionservice.model;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.math.BigDecimal;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/** State 017: trade rows carry an optional, derived cdmRef next to the 009 fields. */
+class TradeTest {
+
+  @Test
+  void jsonKeepsThe009FieldsAndAddsCdmRef() {
+    Trade trade = new Trade();
+    trade.setId("TRADE-22214-AABBCC");
+    trade.setAccountId(22214);
+    trade.setSecurity("IBM");
+    trade.setSide("Sell");
+    trade.setState("Settled");
+    trade.setQuantity(100);
+    trade.setPrice(new BigDecimal("136.250"));
+
+    JsonNode json = JsonMapper.builder().build().valueToTree(trade);
+
+    assertThat(json.get("cdmRef").asString()).isEqualTo("cdm:trade:TRADE-22214-AABBCC");
+    assertThat(json.get("id").asString()).isEqualTo("TRADE-22214-AABBCC");
+    assertThat(json.get("accountId").asInt()).isEqualTo(22214);
+    assertThat(json.get("security").asString()).isEqualTo("IBM");
+    assertThat(json.get("quantity").asInt()).isEqualTo(100);
+    assertThat(json.has("price")).isTrue();
+  }
+
+  @Test
+  void noCdmRefWithoutAnId() {
+    assertThat(new Trade().getCdmRef()).isNull();
+  }
+}
