@@ -0,0 +1,17 @@
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Mvc.Filters;
+
+namespace PeopleService.WebApi.Directory;
+
+/// <summary>Answers 503 when the person authority (cdm-service) cannot be reached.</summary>
+public sealed class CdmServiceUnavailableFilter : IExceptionFilter
+{
+    public void OnException(ExceptionContext context)
+    {
+        if (context.Exception is CdmServiceUnavailableException e)
+        {
+            context.Result = new ObjectResult(e.Message) { StatusCode = StatusCodes.Status503ServiceUnavailable };
+            context.ExceptionHandled = true;
+        }
+    }
+}
