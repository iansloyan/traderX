+})
+class TradeServiceBookedTopicTest {
+  @Configuration
+  @EnableAutoConfiguration
+  @EntityScan(basePackageClasses = Trade.class)
+  @EnableJpaRepositories(basePackageClasses = TradeRepository.class)
+  @Import(TradeService.class)
+  static class Config {
+    @Bean Publisher<Trade> tradePublisher() { return mock(Publisher.class); }
+    @Bean Publisher<Position> positionPublisher() { return mock(Publisher.class); }
+  }
+
+  @Autowired TradeService service;
+  @Autowired DataSource dataSource;
+  @Autowired Publisher<Trade> trades;
+  @Autowired Publisher<Position> positions;
+  JdbcTemplate jdbc;
+
+  @BeforeEach
+  void createSchema() throws Exception {
+    reset(trades, positions);
+    jdbc = new JdbcTemplate(dataSource);
+    try (Connection creator = DriverManager.getConnection("jdbc:h2:mem:booked;DB_CLOSE_DELAY=-1", "sa", "sa")) {
+      Path schema = Path.of("../database/initialSchema.sql");
+      String sql;
+      if (Files.exists(schema)) {
+        sql = Files.readString(schema);
+      } else {
+        try (var resource = getClass().getResourceAsStream("/booking-schema.sql")) {
+          assertNotNull(resource, "booking schema fixture must exist");
+          sql = new String(resource.readAllBytes(), java.nio.charset.StandardCharsets.UTF_8);
+        }
+      }
+      creator.createStatement().execute(sql);
+      creator.createStatement().execute("ALTER TABLE Trades ADD IF NOT EXISTS Price DECIMAL(18,3) DEFAULT 0; ALTER TABLE Positions ADD IF NOT EXISTS AverageCostBasis DECIMAL(18,3) DEFAULT 0");
+    }
+  }
+
+  TradeOrder order(String orderId) {
+    TradeOrder order = new TradeOrder();
+    order.setAccountId(22214); order.setSecurity("META"); order.setSide(TradeSide.Buy); order.setQuantity(7);
+    order.setOrderId(orderId);
+    return order;
+  }
+
+  Trade bookedPayload() throws PubSubException {
+    ArgumentCaptor<Trade> booked = ArgumentCaptor.forClass(Trade.class);
+    verify(trades).publish(eq("/trades/booked"), booked.capture());
+    return booked.getValue();
+  }
+
+  @Test
+  void bookedTradeIsPublishedOnGlobalSubjectWithOrderId() throws Exception {
+    TradeBookingResult result = service.processTrade(order("ord-013-0042"));
+    String tradeId = result.getTrade().getId();
+
+    Trade booked = bookedPayload();
+    assertEquals(tradeId, booked.getId());
+    assertEquals("ord-013-0042", booked.getOrderId());
+    assertEquals("cdm:trade:" + tradeId, booked.getCdmRef());
+    assertEquals(TradeState.Settled, booked.getState());
+
+    // Existing per-account publishes are unchanged (and also carry the additive fields).
+    ArgumentCaptor<Trade> account = ArgumentCaptor.forClass(Trade.class);
+    verify(trades).publish(eq("/accounts/22214/trades"), account.capture());
+    assertEquals(tradeId, account.getValue().getId());
+    verify(positions).publish(eq("/accounts/22214/positions"), any(Position.class));
+
+    // The order link is durable.
+    assertEquals("ord-013-0042", jdbc.queryForObject("SELECT OrderId FROM Trades WHERE ID=?", String.class, tradeId));
+
+    JsonNode json = JsonMapper.builder().build().valueToTree(booked);
+    assertEquals("ord-013-0042", json.get("orderId").asString());
+    assertEquals("cdm:trade:" + tradeId, json.get("cdmRef").asString());
+  }
+
+  @Test
+  void directTradeHasNullOrderId() throws Exception {
+    TradeBookingResult result = service.processTrade(order(null));
+    String tradeId = result.getTrade().getId();
+
+    Trade booked = bookedPayload();
+    assertNull(booked.getOrderId());
+    assertEquals("cdm:trade:" + tradeId, booked.getCdmRef());
+    assertNull(jdbc.queryForObject("SELECT OrderId FROM Trades WHERE ID=?", String.class, tradeId));
+
+    // orderId is present as an explicit null on the wire, even under the publishers' NON_NULL default.
+    JsonNode json = JsonMapper.builder()
+        .changeDefaultPropertyInclusion(v -> v.withValueInclusion(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL))
+        .build().valueToTree(booked);
+    assertTrue(json.has("orderId"));
+    assertTrue(json.get("orderId").isNull());
+  }
+
+  @Test
+  void bookedTopicFailureDoesNotFailBookingOrOtherPublishes() throws Exception {
+    doThrow(new PubSubException("feed unavailable")).when(trades).publish(eq("/trades/booked"), any(Trade.class));
+    assertDoesNotThrow(() -> service.processTrade(order("ord-013-0043")));
+    verify(trades).publish(eq("/accounts/22214/trades"), any(Trade.class));
+    verify(positions).publish(eq("/accounts/22214/positions"), any(Position.class));
+    assertEquals(1, jdbc.queryForObject("SELECT COUNT(*) FROM Trades WHERE OrderId='ord-013-0043'", Integer.class));
+  }
+}
